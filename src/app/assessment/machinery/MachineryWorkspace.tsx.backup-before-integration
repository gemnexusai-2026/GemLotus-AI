function addFinding() {
  const id =
    `machinery-audit-7-${Date.now()}-${findings.length}`;

  setFindings(
    (current) => [
      ...current,
      {
        id,
        title:
          "New Machinery Finding",
        description:
          "",
        severity:
          "observation",
        status:
          "open",
        recommendation:
          "",
      },
    ],
  );
}

function updateFinding(
  id: string,
  patch: Partial<MachineryAudit7Finding>,
) {
  setFindings(
    (current) =>
      current.map(
        (finding) =>
          finding.id === id
            ? {
                ...finding,
                ...patch,
              }
            : finding,
      ),
  );
}

function removeFinding(
  id: string,
) {
  setFindings(
    (current) =>
      current.filter(
        (finding) =>
          finding.id !== id,
      ),
  );
}

const openFindings =
  findings.filter(
    (finding) =>
      finding.status ===
