/* ============================================================
   REPORT METRICS
============================================================ */

type MachineryReport11MetricsData = {
  totalMachines: number;
  verifiedMachines: number;
  operationalMachines: number;
  ownedMachines: number;
  leasedMachines: number;
  sharedMachines: number;
  quantityTotal: number;
  capabilityCoverage: number;
  evidenceCount: number;
  acceptedEvidence: number;
  pendingEvidence: number;
  rejectedEvidence: number;
  verificationCoverage: number;
  openFindings: number;
  criticalFindings: number;
  majorFindings: number;
  overallReadiness: string;
  risk: string;
  score: number;
};


function MachineryReport11Metrics(
  records: MachineryRecord[],
): MachineryReport11MetricsData {
  const totalMachines =
    records.length;


  const verifiedMachines =
    records.filter(
      (record) =>
        "physicalVerification" in
          record &&
        record.physicalVerification ===
          true,
    ).length;


  const operationalMachines =
    records.filter(
      (record) =>
        "operationalDuringVisit" in
          record &&
        record.operationalDuringVisit ===
          true,
    ).length;


  const ownedMachines =
    records.filter(
      (record) =>
        "ownership" in
          record &&
        String(
          record.ownership,
        ).toLowerCase() ===
          "owned",
    ).length;


  const leasedMachines =
    records.filter(
      (record) =>
        "ownership" in
          record &&
        String(
          record.ownership,
        ).toLowerCase() ===
          "leased",
    ).length;


  const sharedMachines =
    records.filter(
      (record) =>
        "ownership" in
          record &&
        String(
          record.ownership,
        ).toLowerCase() ===
          "shared",
    ).length;


  const quantityTotal =
    records.reduce(
      (
        total,
        record,
      ) => {
        if (
          "quantity" in
            record &&
          typeof record.quantity ===
            "number"
        ) {
          return (
            total +
            record.quantity
          );
        }

        return (
          total + 1
        );
      },
      0,
    );


  const capabilityCoverage =
    totalMachines ===
    0
      ? 0
      : Math.round(
          (operationalMachines /
            totalMachines) *
            100,
        );


  /*
   * The report layer intentionally keeps
   * evidence counts neutral because the
   * persisted evidence store will be
   * connected separately.
   */

  const evidenceCount =
    0;

  const acceptedEvidence =
    0;

  const pendingEvidence =
    0;

  const rejectedEvidence =
    0;

  const verificationCoverage =
    0;


  const openFindings =
    0;

  const criticalFindings =
    0;

  const majorFindings =
    0;


  const score =
    MachineryReport11BaseScore(
      totalMachines,
      verifiedMachines,
      operationalMachines,
    );


  const risk =
    MachineryReport11Risk(
      score,
      criticalFindings,
      rejectedEvidence,
    );


  const overallReadiness =
    MachineryReport11Readiness(
      score,
      criticalFindings,
      rejectedEvidence,
    );


  return {
    totalMachines,
    verifiedMachines,
    operationalMachines,
    ownedMachines,
    leasedMachines,
    sharedMachines,
    quantityTotal,
    capabilityCoverage,
    evidenceCount,
    acceptedEvidence,
    pendingEvidence,
    rejectedEvidence,
    verificationCoverage,
    openFindings,
    criticalFindings,
    majorFindings,
    overallReadiness,
    risk,
    score,
  };
}


/* ============================================================
   BASE SCORE
============================================================ */

function MachineryReport11BaseScore(
  total: number,
  verified: number,
  operational: number,
): number {
  if (
    total ===
    0
  ) {
    return 0;
  }


  const physical =
    (verified /
      total) *
    50;


  const operationalScore =
    (operational /
      total) *
    50;


  return Math.round(
    physical +
      operationalScore,
  );
}


/* ============================================================
   RISK
============================================================ */

function MachineryReport11Risk(
  score: number,
  critical: number,
  rejectedEvidence: number,
): string {
  if (
    critical >
    0
  ) {
    return "Critical";
  }


  if (
    rejectedEvidence >
    0
  ) {
    return "High";
  }


  if (
    score <
    50
  ) {
    return "High";
  }


  if (
    score <
    70
  ) {
    return "Moderate";
  }


  return "Low";
}


/* ============================================================
   READINESS
============================================================ */

function MachineryReport11Readiness(
  score: number,
  critical: number,
  rejectedEvidence: number,
): string {
  if (
    critical >
    0 ||
    rejectedEvidence >
      0
  ) {
    return "Not Ready";
  }


  if (
    score >=
    80
  ) {
    return "Ready";
  }


  if (
    score >=
    65
  ) {
    return "Conditionally Ready";
  }


  if (
    score >=
    45
  ) {
    return "Needs Improvement";
  }


  return "Not Ready";
}


