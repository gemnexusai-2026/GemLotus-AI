============================================================ */

type MachineryEvidenceItem = {
id: string;
category: MachineryEvidenceCategory;
title: string;
description: string;
required: boolean;
status: MachineryEvidenceStatus;
fileName: string;
fileSize: number;
fileType: string;
};


/* ============================================================
 EVIDENCE DEFINITIONS
============================================================ */

const MACHINERY_EVIDENCE_DEFINITIONS: Array<{
category: MachineryEvidenceCategory;
title: string;
description: string;
required: boolean;
}> = [
{
  category: "machine_photo",
  title: "Machine Photograph",
  description:
    "Clear photograph showing the complete machine physically installed at the factory.",
  required: true,
},

{
