            type="button"
            onClick={addRecord}
            className="rounded-xl border border-cyan-300/15 bg-cyan-300/[0.05] px-4 py-3 text-[9px] font-bold uppercase tracking-[0.15em] text-cyan-200 transition hover:bg-cyan-300/[0.10]"
