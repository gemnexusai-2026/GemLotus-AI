              }
              className="h-4 w-4 accent-cyan-400"
            />

            <span className="text-[9px] text-white/45">
              Show only evidence gaps
            </span>

          </label>

        </div>

      </div>


      {/* ======================================================
         STATUS METRICS
      ====================================================== */}

      <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">

        <MachineryEvidence8Metric
          label="Total"
          value={
            total
          }
        />

        <MachineryEvidence8Metric
          label="Available"
          value={
            available
          }
          positive={
            available > 0
          }
        />

        <MachineryEvidence8Metric
          label="Missing"
          value={
            missing
          }
          warning={
            missing > 0
          }
        />

        <MachineryEvidence8Metric
          label="Pending Review"
          value={
            pending
          }
          warning={
            pending > 0
          }
        />

        <MachineryEvidence8Metric
          label="Rejected"
          value={
            rejected
          }
          danger={
            rejected > 0
          }
        />

      </div>


      {/* ======================================================
         MATRIX
      ====================================================== */}

      <div className="overflow-hidden rounded-2xl border border-white/[0.07] bg-black/[0.13]">

        <div className="border-b border-white/[0.06] p-5">

          <div className="text-[8px] font-bold uppercase tracking-[0.18em] text-white/30">
            Evidence Register
          </div>

          <h4 className="mt-1 text-sm font-semibold text-white/70">
            Requirement-by-Requirement Review
          </h4>

        </div>


        {filtered.length ===
          0 ? (
          <div className="p-8 text-center text-[9px] text-white/25">
            No evidence records match the current filter.
          </div>
        ) : (
          <div className="space-y-3 p-4">

            {filtered.map(
              (item) => (
                <MachineryEvidence8Row
