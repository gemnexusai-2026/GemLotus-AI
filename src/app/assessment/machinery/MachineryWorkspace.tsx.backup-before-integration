  /* ============================================================
     SUMMARY CALCULATION
  ============================================================ */
  
  type MachineryAssessmentSummaryData = {
    totalMachinery: number;
  
    physicalVerified: number;
  
    operationalMachinery: number;
  
    evidenceCoverage: number;
  
    evidenceCompleted: number;
  
    evidenceRequired: number;
  
    machinesWithEvidence: number;
  
    maintenanceReady: number;
  
    maintenanceRisk: number;
  
    maintenanceScore: number;
  
    physicalScore: number;
  
    ownedMachinery: number;
  
    leasedMachinery: number;
  
    rentedMachinery: number;
  
    sharedMachinery: number;
  
    overallScore: number;
  
    readinessLevel: string;
  
    risks: string[];
  };
  
  
  function calculateMachineryAssessmentSummary(
    records: MachineryRecord[],
  ): MachineryAssessmentSummaryData {
    const total =
      records.length;
  
    if (total === 0) {
      return {
        totalMachinery: 0,
  
        physicalVerified: 0,
  
        operationalMachinery: 0,
  
        evidenceCoverage: 0,
  
        evidenceCompleted: 0,
  
        evidenceRequired: 0,
  
        machinesWithEvidence: 0,
  
        maintenanceReady: 0,
  
        maintenanceRisk: 0,
  
        maintenanceScore: 0,
  
        physicalScore: 0,
  
        ownedMachinery: 0,
  
        leasedMachinery: 0,
  
        rentedMachinery: 0,
  
        sharedMachinery: 0,
  
        overallScore: 0,
  
        readinessLevel:
          "Not Assessed",
  
        risks: [
          "No machinery records have been entered.",
        ],
      };
    }
  
  
    /* ==========================================================
       PHYSICAL
    ========================================================== */
  
    const physicalVerified =
      records.filter(
        (record) =>
          getBoolean(
            record,
            "physicalVerification",
          ),
      ).length;
  
  
    const operationalMachinery =
      records.filter(
        (record) =>
          getBoolean(
            record,
            "operationalDuringVisit",
          ),
      ).length;
  
  
    const physicalScore =
      Math.round(
        ((physicalVerified +
          operationalMachinery) /
          (total * 2)) *
          100,
      );
  
  
    /* ==========================================================
       EVIDENCE
    ========================================================== */
  
    let evidenceRequired =
      0;
  
    let evidenceCompleted =
      0;
  
    let machinesWithEvidence =
      0;
  
  
    records.forEach(
      (record) => {
        const required =
          MACHINERY_EVIDENCE_DEFINITIONS.filter(
            (item) =>
              item.required,
          );
  
        evidenceRequired +=
          required.length;
  
        let machineEvidence =
          0;
  
        required.forEach(
          (definition) => {
            const available =
              getBooleanForEvidence(
                record,
                definition.category,
              );
  
            if (available) {
              evidenceCompleted++;
              machineEvidence++;
            }
          },
        );
  
        if (
          machineEvidence > 0
        ) {
          machinesWithEvidence++;
        }
      },
    );
  
  
    const evidenceCoverage =
      evidenceRequired === 0
        ? 0
        : Math.round(
            (evidenceCompleted /
              evidenceRequired) *
              100,
          );
  
  
    /* ==========================================================
       MAINTENANCE
    ========================================================== */
  
    const maintenanceReady =
      records.filter(
        (record) =>
          getBoolean(
            record,
            "maintenanceAvailable",
          ) ||
          getBoolean(
            record,
            "maintenanceRecordAvailable",
          ),
      ).length;
  
  
    const maintenanceRisk =
      total -
      maintenanceReady;
  
  
    const maintenanceScore =
      Math.round(
        (maintenanceReady /
          total) *
          100,
      );
  
  
    /* ==========================================================
       OWNERSHIP
    ========================================================== */
  
    const ownershipCounts =
      countMachineryOwnership(
        records,
      );
  
  
    /* ==========================================================
       OVERALL SCORE
    ========================================================== */
  
    const overallScore =
      Math.round(
        physicalScore * 0.35 +
          evidenceCoverage * 0.40 +
          maintenanceScore * 0.15 +
          calculateOperationalScore(
            records,
          ) *
            0.10,
      );
  
  
    const readinessLevel =
      getMachineryReadinessLevel(
        overallScore,
      );
  
  
    /* ==========================================================
       RISK FLAGS
    ========================================================== */
  
    const risks: string[] =
      [];
  
  
    if (
      physicalVerified <
      total
    ) {
      risks.push(
        `${
          total -
          physicalVerified
        } machinery record(s) are not physically verified.`,
      );
    }
  
  
    if (
      operationalMachinery <
      total
    ) {
      risks.push(
        `${
          total -
          operationalMachinery
        } machinery record(s) were not observed operational.`,
      );
    }
  
  
    if (
      evidenceCoverage <
      80
    ) {
      risks.push(
        `Required machinery evidence coverage is only ${evidenceCoverage}%.`,
      );
    }
  
  
    if (
      maintenanceScore <
      70
    ) {
      risks.push(
        `${maintenanceRisk} machinery record(s) do not have clear maintenance evidence.`,
      );
    }
  
  
    if (
      ownershipCounts.leased +
        ownershipCounts.rented >
      0
    ) {
      risks.push(
        `${
          ownershipCounts.leased +
          ownershipCounts.rented
        } machinery record(s) are not owned outright and require documentary verification.`,
      );
    }
  
  
    records.forEach(
      (record, index) => {
        const status =
          getString(
            record,
            "verificationStatus",
          );
  
        if (
          status ===
          "rejected"
        ) {
          risks.push(
            `Machinery #${
              index + 1
            } has a rejected verification status.`,
          );
        }
  
        if (
          status ===
          "needs_review"
        ) {
          risks.push(
            `Machinery #${
              index + 1
            } requires additional review.`,
          );
        }
      },
    );
  
  
    if (
      risks.length === 0
    ) {
      risks.push(
        "No major machinery readiness risk flags detected.",
      );
    }
  
  
    return {
      totalMachinery:
        total,
  
      physicalVerified,
  
      operationalMachinery,
  
      evidenceCoverage,
  
      evidenceCompleted,
  
      evidenceRequired,
  
      machinesWithEvidence,
  
      maintenanceReady,
  
      maintenanceRisk,
  
      maintenanceScore,
  
      physicalScore,
  
      ownedMachinery:
        ownershipCounts.owned,
  
      leasedMachinery:
        ownershipCounts.leased,
  
      rentedMachinery:
        ownershipCounts.rented,
  
      sharedMachinery:
        ownershipCounts.shared,
  
      overallScore,
  
      readinessLevel,
  
      risks,
    };
  }
  
  
  /* ============================================================
     OPERATIONAL SCORE
  ============================================================ */
  
  function calculateOperationalScore(
    records: MachineryRecord[],
  ): number {
    if (
      records.length === 0
    ) {
      return 0;
    }
  
    const operational =
      records.filter(
        (record) =>
          getBoolean(
            record,
            "operationalDuringVisit",
          ),
      ).length;
  
    return Math.round(
      (operational /
        records.length) *
        100,
    );
  }
  
  
  /* ============================================================
     OWNERSHIP COUNTER
  ============================================================ */
  
  function countMachineryOwnership(
    records: MachineryRecord[],
  ) {
    let owned = 0;
  
    let leased = 0;
  
    let rented = 0;
  
    let shared = 0;
  
  
    records.forEach(
      (record) => {
        const ownership =
          getString(
            record,
            "ownership",
          ).toLowerCase();
  
        if (
          ownership ===
          "leased"
        ) {
          leased++;
          return;
        }
  
        if (
          ownership ===
          "rented"
        ) {
          rented++;
          return;
        }
  
        if (
          ownership ===
          "shared"
        ) {
          shared++;
          return;
        }
  
        owned++;
      },
    );
  
  
    return {
      owned,
      leased,
      rented,
      shared,
    };
  }
  
  
  /* ============================================================
     EVIDENCE BOOLEAN MAPPER
  ============================================================ */
  
  function getBooleanForEvidence(
    record: MachineryRecord,
    category: MachineryEvidenceCategory,
  ): boolean {
    switch (
      category
    ) {
      case "machine_photo":
        return getBoolean(
          record,
          "photographAvailable",
        );
  
      case "nameplate_photo":
        return getBoolean(
          record,
          "nameplatePhotographAvailable",
        );
  
      case "serial_photo":
        return getBoolean(
          record,
          "serialEvidenceAvailable",
        );
  
      case "ownership_document":
        return getBoolean(
          record,
          "purchaseDocumentAvailable",
        );
  
      case "purchase_invoice":
        return getBoolean(
          record,
          "invoiceAvailable",
        );
  
      case "maintenance_record":
        return (
          getBoolean(
            record,
            "maintenanceRecordAvailable",
          ) ||
          getBoolean(
            record,
            "maintenanceAvailable",
          )
        );
  
      case "calibration_record":
        return getBoolean(
          record,
          "calibrationRecordAvailable",
        );
  
      case "machine_manual":
        return getBoolean(
          record,
          "manualAvailable",
        );
  
      case "other":
        return getBoolean(
          record,
          "otherEvidenceAvailable",
        );
  
      default:
        return false;
    }
  }
  
  
  /* ============================================================
     READINESS LEVEL
  ============================================================ */
  
  function getMachineryReadinessLevel(
    score: number,
  ): string {
    if (score >= 90) {
      return "Excellent";
    }
  
    if (score >= 75) {
      return "Ready";
    }
  
    if (score >= 60) {
      return "Conditionally Ready";
    }
  
    if (score >= 40) {
      return "Needs Improvement";
    }
  
    return "High Risk";
  }
  
  
