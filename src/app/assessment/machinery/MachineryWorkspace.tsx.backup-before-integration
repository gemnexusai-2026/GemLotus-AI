/* ============================================================
   METRIC
============================================================ */

function MachineryEvidence8Metric({
  label,
  value,
  positive,
  warning,
  danger,
}: {
  label: string;
  value: number;
  positive?: boolean;
  warning?: boolean;
  danger?: boolean;
}) {
  let valueClass =
    "text-cyan-200";

  if (
    positive
  ) {
    valueClass =
      "text-emerald-200";
  }

  if (
    warning
  ) {
    valueClass =
      "text-amber-200";
  }

  if (
    danger
  ) {
    valueClass =
      "text-red-200";
  }

  return (
    <div className="rounded-2xl border border-white/[0.07] bg-black/[0.13] p-4">

      <div className="text-[7px] font-bold uppercase tracking-[0.14em] text-white/25">
        {label}
      </div>

      <div
        className={`mt-2 text-2xl font-semibold ${valueClass}`}
      >
        {value}
      </div>

    </div>
  );
}


/* ============================================================
   STATUS BADGE
============================================================ */

function MachineryEvidence8StatusBadge({
  status,
}: {
  status: MachineryEvidence8Status;
}) {
  let className =
    "border-white/[0.08] bg-white/[0.03] text-white/35";

  if (
    status ===
    "available"
  ) {
    className =
      "border-emerald-300/10 bg-emerald-300/[0.04] text-emerald-200";
  }

  if (
    status ===
    "missing"
  ) {
    className =
      "border-amber-300/10 bg-amber-300/[0.04] text-amber-200";
  }

  if (
    status ===
    "pending_review"
  ) {
    className =
      "border-blue-300/10 bg-blue-300/[0.04] text-blue-200";
  }

  if (
    status ===
    "rejected"
  ) {
    className =
      "border-red-300/10 bg-red-300/[0.04] text-red-200";
  }

  return (
    <span
      className={`inline-flex rounded-md border px-2 py-1 text-[6px] font-bold uppercase tracking-[0.1em] ${className}`}
    >
      {MachineryEvidence8Label(
        status,
      )}
    </span>
  );
}


/* ============================================================
   GAP SUMMARY
============================================================ */

function MachineryEvidence8GapSummary({
  items,
}: {
  items: MachineryEvidence8Item[];
}) {
  const gaps =
    items.filter(
      (item) =>
        item.required &&
        item.status !==
          "available",
    );

  const critical =
    gaps.filter(
      (item) =>
        item.priority ===
          "critical" ||
        item.status ===
          "rejected",
    );

  const high =
    gaps.filter(
      (item) =>
        item.priority ===
        "high",
    );


  return (
    <div className="rounded-2xl border border-amber-300/10 bg-amber-300/[0.025] p-5">

      <div className="flex items-start gap-3">

        <div className="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-amber-300/10 text-amber-200">
          !
        </div>

        <div>

          <div className="text-[8px] font-bold uppercase tracking-[0.18em] text-amber-300/55">
            Evidence Gap Summary
          </div>

          <div className="mt-1 text-sm font-semibold text-white/70">
            Outstanding Required Evidence
          </div>

        </div>

      </div>


      <div className="mt-5 grid gap-3 sm:grid-cols-3">

        <div className="rounded-xl border border-white/[0.05] bg-black/[0.12] p-3">

          <div className="text-[7px] uppercase tracking-wider text-white/20">
            Required Gaps
          </div>

          <div className="mt-1 text-lg font-semibold text-amber-200">
            {gaps.length}
          </div>

        </div>


        <div className="rounded-xl border border-white/[0.05] bg-black/[0.12] p-3">

          <div className="text-[7px] uppercase tracking-wider text-white/20">
            High Priority
          </div>

          <div className="mt-1 text-lg font-semibold text-orange-200">
            {high.length}
          </div>

        </div>


        <div className="rounded-xl border border-white/[0.05] bg-black/[0.12] p-3">

          <div className="text-[7px] uppercase tracking-wider text-white/20">
            Critical
          </div>

          <div className="mt-1 text-lg font-semibold text-red-200">
            {critical.length}
          </div>

        </div>

      </div>


      {gaps.length >
        0 && (
        <div className="mt-5 space-y-2">

          {gaps
            .slice(0, 12)
            .map(
              (item) => (
                <div
                  key={
                    item.id
                  }
                  className="rounded-xl border border-white/[0.05] bg-black/[0.12] p-3"
                >

                  <div className="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">

                    <span className="text-[9px] text-white/45">
                      {item.title}
                    </span>

                    <MachineryEvidence8StatusBadge
                      status={
                        item.status
                      }
                    />

                  </div>

                  {item.correctiveAction && (
                    <p className="mt-2 text-[8px] leading-5 text-white/25">
                      Action:{" "}
                      {
                        item.correctiveAction
                      }
                    </p>
                  )}

                </div>
              ),
            )}

        </div>
      )}


      {gaps.length ===
        0 && (
        <div className="mt-5 rounded-xl border border-emerald-300/10 bg-emerald-300/[0.025] p-4 text-[9px] text-emerald-200/70">
          All currently defined required machinery
          evidence items are marked available.
        </div>
      )}

    </div>
  );
}


/* ============================================================
   LABEL FORMATTER
============================================================ */

function MachineryEvidence8Label(
  value: string,
): string {
  return value
    .replace(
      /_/g,
      " ",
    )
    .replace(
      /\b\w/g,
      (character) =>
        character.toUpperCase(),
    );
}

/* ============================================================
   PART 9 — EVIDENCE UPLOAD & VERIFICATION WORKSPACE
   ------------------------------------------------------------
   Purpose:
   - Evidence record creation
   - Evidence classification
   - Evidence source tracking
   - File metadata capture
   - Verification workflow
   - Accept / reject / needs-review
   - Assessor remarks
   - Verification audit trail
   - No external helper dependencies
   - No database/schema assumptions
============================================================ */


/* ============================================================
   TYPES
============================================================ */

type MachineryEvidence9Kind =
  | "document"
  | "photo"
  | "video"
  | "certificate"
  | "invoice"
  | "record"
  | "other";

type MachineryEvidence9Verification =
  | "pending"
  | "accepted"
  | "rejected"
  | "needs_review";

type MachineryEvidence9Source =
  | "factory"
  | "assessor"
  | "third_party"
  | "external_lab"
  | "other";

type MachineryEvidence9Record = {
  id: string;

  machineryIndex?: number;

  title: string;

  kind: MachineryEvidence9Kind;

  source: MachineryEvidence9Source;

  fileName: string;

  fileType: string;

  fileSize: string;

  documentNumber: string;

  issueDate: string;

  expiryDate: string;

  verification:
    MachineryEvidence9Verification;

  verifierName: string;

  verificationDate: string;

  remarks: string;

  rejectionReason: string;
};


/* ============================================================
   MAIN EVIDENCE WORKSPACE
============================================================ */

function MachineryEvidence9Workspace({
  records,
}: {
  records: MachineryRecord[];
}) {
  const [
    evidence,
    setEvidence,
  ] = useState<
    MachineryEvidence9Record[]
  >([]);

  const [
    selectedMachine,
    setSelectedMachine,
  ] = useState<
    number | "all"
  >("all");

  const [
    selectedVerification,
    setSelectedVerification,
  ] = useState<
    MachineryEvidence9Verification |
    "all"
  >("all");

  const [
    showForm,
    setShowForm,
  ] = useState(false);


  function addEvidence() {
    const newEvidence: MachineryEvidence9Record =
      {
        id:
          `evidence-9-${Date.now()}-${evidence.length}`,

        title:
          "",

        kind:
          "document",

        source:
          "factory",

        fileName:
          "",

        fileType:
          "",

        fileSize:
          "",

        documentNumber:
          "",

        issueDate:
          "",

        expiryDate:
          "",

        verification:
          "pending",

        verifierName:
          "",

        verificationDate:
          "",

        remarks:
          "",

        rejectionReason:
          "",
      };

    setEvidence(
      (current) => [
        ...current,
        newEvidence,
      ],
    );

    setShowForm(true);
  }


  function updateEvidence(
    id: string,
    patch: Partial<MachineryEvidence9Record>,
  ) {
    setEvidence(
      (current) =>
        current.map(
          (item) =>
            item.id === id
              ? {
                  ...item,
                  ...patch,
                }
              : item,
        ),
    );
  }


  function removeEvidence(
    id: string,
  ) {
    setEvidence(
      (current) =>
        current.filter(
          (item) =>
            item.id !== id,
        ),
    );
  }


  const filteredEvidence =
    evidence.filter(
      (item) => {
        if (
          selectedMachine !==
          "all"
        ) {
          if (
            item.machineryIndex !==
            selectedMachine
          ) {
            return false;
          }
        }

        if (
          selectedVerification !==
          "all" &&
          item.verification !==
            selectedVerification
        ) {
          return false;
        }

        return true;
      },
    );


  const total =
    evidence.length;

  const accepted =
    evidence.filter(
      (item) =>
        item.verification ===
        "accepted",
    ).length;

  const pending =
    evidence.filter(
      (item) =>
        item.verification ===
        "pending",
    ).length;

  const needsReview =
    evidence.filter(
      (item) =>
        item.verification ===
        "needs_review",
    ).length;

  const rejected =
    evidence.filter(
      (item) =>
        item.verification ===
        "rejected",
    ).length;


  return (
    <div className="space-y-6">

      {/* ======================================================
         HEADER
      ====================================================== */}

      <div className="rounded-2xl border border-cyan-300/10 bg-cyan-300/[0.025] p-5">

        <div className="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">

          <div>

            <div className="text-[8px] font-bold uppercase tracking-[0.20em] text-cyan-300/50">
              Step 09 • Evidence Verification
            </div>

            <h3 className="mt-1 text-lg font-semibold text-white">
              Evidence Upload & Verification
            </h3>

            <p className="mt-2 max-w-3xl text-[10px] leading-6 text-white/30">
              Register supporting evidence, associate
              it with machinery, capture document
              metadata and complete assessor verification.
            </p>

          </div>


          <button
            type="button"
            onClick={
              addEvidence
            }
            className="rounded-xl bg-gradient-to-r from-cyan-400 to-blue-500 px-5 py-3 text-[8px] font-bold uppercase tracking-[0.14em] text-[#031020] transition hover:brightness-110"
          >
            + Add Evidence
          </button>

        </div>

      </div>


      {/* ======================================================
         SUMMARY
      ====================================================== */}

      <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">

        <MachineryEvidence9Metric
          label="Total Evidence"
          value={
            total
          }
        />

        <MachineryEvidence9Metric
          label="Accepted"
          value={
            accepted
          }
          positive={
            accepted > 0
          }
        />

        <MachineryEvidence9Metric
          label="Pending"
          value={
            pending
          }
          warning={
            pending > 0
          }
        />

        <MachineryEvidence9Metric
          label="Needs Review"
          value={
            needsReview
          }
          warning={
            needsReview > 0
          }
        />

        <MachineryEvidence9Metric
          label="Rejected"
          value={
            rejected
          }
          danger={
            rejected > 0
          }
        />

      </div>


      {/* ======================================================
         FILTER BAR
      ====================================================== */}

      <div className="rounded-2xl border border-white/[0.07] bg-black/[0.13] p-4">

        <div className="grid gap-4 md:grid-cols-2">

          <label className="block">

            <span className="mb-2 block text-[7px] font-bold uppercase tracking-[0.15em] text-white/25">
              Machinery
            </span>

            <select
              value={
                selectedMachine ===
                "all"
                  ? "all"
                  : String(
                      selectedMachine,
                    )
              }
              onChange={(event) => {
                const value =
                  event.target
                    .value;

                setSelectedMachine(
                  value ===
                    "all"
                    ? "all"
                    : Number(
                        value,
                      ),
                );
              }}
              className="w-full rounded-xl border border-white/[0.08] bg-[#071426] px-4 py-3 text-[10px] text-white outline-none focus:border-cyan-300/25"
            >

              <option value="all">
                All Machinery
              </option>

              {records.map(
                (
                  record,
                  index,
                ) => (
                  <option
                    key={
                      `evidence9-machine-${index}`
                    }
                    value={String(
                      index,
                    )}
                  >
                    {MachineryEvidence9MachineName(
                      record,
                      index,
                    )}
                  </option>
                ),
              )}

            </select>

          </label>


          <label className="block">

            <span className="mb-2 block text-[7px] font-bold uppercase tracking-[0.15em] text-white/25">
              Verification Status
            </span>

            <select
              value={
                selectedVerification
              }
              onChange={(event) =>
                setSelectedVerification(
                  event.target
                    .value as
                    | MachineryEvidence9Verification
                    | "all",
                )
              }
              className="w-full rounded-xl border border-white/[0.08] bg-[#071426] px-4 py-3 text-[10px] text-white outline-none focus:border-cyan-300/25"
            >

              <option value="all">
                All Statuses
              </option>

              <option value="pending">
                Pending
              </option>

              <option value="accepted">
                Accepted
              </option>

              <option value="needs_review">
                Needs Review
              </option>

              <option value="rejected">
                Rejected
              </option>

            </select>

          </label>

        </div>

      </div>


      {/* ======================================================
         EVIDENCE REGISTER
      ====================================================== */}

      <div className="rounded-2xl border border-white/[0.07] bg-black/[0.13] p-5">

        <div className="mb-5">

          <div className="text-[8px] font-bold uppercase tracking-[0.18em] text-white/30">
            Evidence Register
          </div>

          <h4 className="mt-1 text-sm font-semibold text-white/70">
            Uploaded / Referenced Evidence
          </h4>

        </div>


        {filteredEvidence.length ===
          0 ? (
          <div className="rounded-xl border border-dashed border-white/[0.08] bg-black/[0.10] p-8 text-center">

            <div className="text-sm font-semibold text-white/40">
              No evidence records
            </div>

            <p className="mt-2 text-[9px] leading-5 text-white/20">
              Add a document, photograph, certificate,
              invoice, record or other supporting evidence.
            </p>

            <button
              type="button"
              onClick={
                addEvidence
              }
              className="mt-4 rounded-xl border border-cyan-300/15 bg-cyan-300/[0.04] px-4 py-2.5 text-[8px] font-bold uppercase tracking-[0.13em] text-cyan-200"
            >
              Add First Evidence
            </button>

          </div>
        ) : (
          <div className="space-y-4">

            {filteredEvidence.map(
              (
                item,
              ) => (
                <MachineryEvidence9Editor
                  key={
                    item.id
                  }
                  item={
                    item
                  }
                  records={
                    records
                  }
                  onUpdate={(
                    patch,
                  ) =>
                    updateEvidence(
                      item.id,
                      patch,
                    )
                  }
                  onRemove={() =>
                    removeEvidence(
                      item.id,
                    )
                  }
                />
              ),
            )}

          </div>
        )}

      </div>


      {/* ======================================================
         VERIFICATION SUMMARY
      ====================================================== */}

      <MachineryEvidence9VerificationSummary
        total={
          total
        }
        accepted={
          accepted
        }
        pending={
          pending
        }
        needsReview={
          needsReview
        }
        rejected={
          rejected
        }
      />

    </div>
  );
}


