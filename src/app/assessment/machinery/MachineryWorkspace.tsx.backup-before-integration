/* ============================================================
   SCORING ENGINE
============================================================ */

function MachineryScore15Calculate(
  records: MachineryRecord[],
  evidence: MachineryTrace13Evidence[],
  verifications: MachineryTrace13Verification[],
  findings: MachineryFinding14Record[],
): MachineryScore15Result {
  const machineryCount =
    records.length;


  if (
    machineryCount ===
    0
  ) {
    return {
      overallScore: 0,

      capabilityScore: 0,

      evidenceScore: 0,

      verificationScore: 0,

      findingScore: 0,

      machineryCount: 0,

      assessedMachinery: 0,

      criticalFindings: 0,

      majorFindings: 0,

      openFindings: 0,

      closedFindings: 0,

      decision:
        "not_assessed",

      components: [],

      strengths: [],

      gaps: [
        "No machinery records have been entered.",
      ],

      blockers: [
        "Machinery register is empty.",
      ],
    };
  }


  /* ==========================================================
     MACHINERY CAPABILITY
  ========================================================== */

  let capabilityPoints = 0;


  const capabilityMax =
    machineryCount *
    5;


  records.forEach(
    (record) => {
      let points = 0;


      if (
        MachineryScore15HasText(
          record,
          "name",
        ) ||
        MachineryScore15HasText(
          record,
          "machineName",
        ) ||
        MachineryScore15HasText(
          record,
          "equipmentName",
        )
      ) {
        points += 1;
      }


      if (
        MachineryScore15HasText(
          record,
          "manufacturer",
        )
      ) {
        points += 1;
      }


      if (
        MachineryScore15HasText(
          record,
          "model",
        ) ||
        MachineryScore15HasText(
          record,
          "machineModel",
        )
      ) {
        points += 1;
      }


      if (
        MachineryScore15HasPositiveNumber(
          record,
          "quantity",
        )
      ) {
        points += 1;
      }


      if (
        MachineryScore15HasText(
          record,
          "capacity",
        ) ||
        MachineryScore15HasText(
          record,
          "year",
        )
      ) {
        points += 1;
      }


      capabilityPoints +=
        points;
    },
  );


  const capabilityScore =
    capabilityMax ===
    0
      ? 0
      : Math.round(
          (capabilityPoints /
            capabilityMax) *
            100,
        );


  /* ==========================================================
     EVIDENCE
  ========================================================== */

  const evidenceMachineSet =
    new Set(
      evidence
        .filter(
          (item) =>
            item.status !==
              "rejected" &&
            item.status !==
              "not_applicable",
        )
        .map(
          (item) =>
            item.machineryIndex,
        ),
    );


  const evidenceScore =
    Math.round(
      (evidenceMachineSet.size /
        machineryCount) *
        100,
    );


  /* ==========================================================
     VERIFICATION
  ========================================================== */

  const verificationMachineSet =
    new Set(
      verifications
        .filter(
          (item) =>
            item.status ===
            "verified",
        )
        .map(
          (item) =>
            item.machineryIndex,
        ),
    );


  const verificationScore =
    Math.round(
      (verificationMachineSet.size /
        machineryCount) *
        100,
    );


  /* ==========================================================
     FINDINGS
  ========================================================== */

  const criticalFindings =
    findings.filter(
      (item) =>
        item.classification ===
        "critical",
    ).length;


  const majorFindings =
    findings.filter(
      (item) =>
        item.classification ===
        "major",
    ).length;


  const openFindings =
    findings.filter(
      (item) =>
        item.status !==
          "closed" &&
        item.status !==
          "rejected",
    ).length;


  const closedFindings =
    findings.filter(
      (item) =>
        item.status ===
        "closed",
    ).length;


  let findingScore =
    100;


  findingScore -=
    criticalFindings *
    30;


  findingScore -=
    majorFindings *
    15;


  findingScore -=
    findings.filter(
      (item) =>
        item.classification ===
        "minor" &&
        item.status !==
          "closed",
    ).length *
    5;


  findingScore -=
    findings.filter(
      (item) =>
        item.classification ===
          "observation" &&
        item.status !==
          "closed",
    ).length *
    2;


  findingScore =
    Math.max(
      0,
      Math.min(
        100,
        findingScore,
      ),
    );


  /* ==========================================================
     WEIGHTED OVERALL
     Capability       40
     Evidence         20
     Verification     20
     Finding Control  20
  ========================================================== */

  const overallScore =
    Math.round(
      capabilityScore *
        0.4 +
        evidenceScore *
          0.2 +
        verificationScore *
          0.2 +
        findingScore *
          0.2,
    );


  /* ==========================================================
     ASSESSED MACHINERY
  ========================================================== */

  const assessedSet =
    new Set<number>();


  records.forEach(
    (_, index) => {
      const hasEvidence =
        evidenceMachineSet.has(
          index,
        );


      const hasVerification =
        verificationMachineSet.has(
          index,
        );


      const hasFinding =
        findings.some(
          (item) =>
            item.machineryIndex ===
            index,
        );


      if (
        hasEvidence ||
        hasVerification ||
        hasFinding
      ) {
        assessedSet.add(
          index,
        );
      }
    },
  );


  const assessedMachinery =
    assessedSet.size;


  /* ==========================================================
     COMPONENT STATUS
  ========================================================== */

  const components: MachineryScore15Component[] =
    [
      {
        key: "capability",

        label:
          "Machinery Capability",

        weight: 40,

        score:
          capabilityScore,

        weightedScore:
          Math.round(
            capabilityScore *
              0.4,
          ),

        status:
          MachineryScore15Band(
            capabilityScore,
          ),

        observation:
          "Based on basic identification, manufacturer/model, quantity and capacity information.",
      },

      {
        key: "evidence",

        label:
          "Evidence Coverage",

        weight: 20,

        score:
          evidenceScore,

        weightedScore:
          Math.round(
            evidenceScore *
              0.2,
          ),

        status:
          MachineryScore15Band(
            evidenceScore,
          ),

        observation:
          "Measures machinery records linked to acceptable evidence.",
      },

      {
        key: "verification",

        label:
          "Verification Coverage",

        weight: 20,

        score:
          verificationScore,

        weightedScore:
          Math.round(
            verificationScore *
              0.2,
          ),

        status:
          MachineryScore15Band(
            verificationScore,
          ),

        observation:
          "Measures machinery records having verified assessment activity.",
      },

      {
        key: "findings",

        label:
          "Finding Control",

        weight: 20,

        score:
          findingScore,

        weightedScore:
          Math.round(
            findingScore *
              0.2,
          ),

        status:
          MachineryScore15Band(
            findingScore,
          ),

        observation:
          "Penalizes unresolved minor, major and critical findings.",
      },
    ];


  /* ==========================================================
     STRENGTHS
  ========================================================== */

  const strengths: string[] =
    [];


  if (
    capabilityScore >=
    80
  ) {
    strengths.push(
      "Machinery register contains strong basic capability information.",
    );
  }


  if (
    evidenceScore >=
    80
  ) {
    strengths.push(
      "Machinery evidence coverage is strong.",
    );
  }


  if (
    verificationScore >=
    80
  ) {
    strengths.push(
      "Machinery verification coverage is strong.",
    );
  }


  if (
    findingScore >=
    90
  ) {
    strengths.push(
      "Finding control is currently strong.",
    );
  }


  if (
    criticalFindings ===
    0
  ) {
    strengths.push(
      "No critical machinery findings are recorded.",
    );
  }


  if (
    majorFindings ===
    0
  ) {
    strengths.push(
      "No major machinery findings are recorded.",
    );
  }


  /* ==========================================================
     GAPS
  ========================================================== */

  const gaps: string[] =
    [];


  if (
    capabilityScore <
    80
  ) {
    gaps.push(
      "Machinery capability records are incomplete.",
    );
  }


  if (
    evidenceScore <
    80
  ) {
    gaps.push(
      "Evidence coverage is below the internal readiness threshold.",
    );
  }


  if (
    verificationScore <
    80
  ) {
    gaps.push(
      "Physical or documentary verification coverage is incomplete.",
    );
  }


  if (
    openFindings >
    0
  ) {
    gaps.push(
      `${openFindings} finding(s) remain open or require action.`,
    );
  }


  if (
    closedFindings <
      findings.length &&
    findings.length >
      0
  ) {
    gaps.push(
      "Not all findings have completed closure and verification.",
    );
  }


  /* ==========================================================
     BLOCKERS
  ========================================================== */

  const blockers: string[] =
    [];


  if (
    criticalFindings >
    0
  ) {
    blockers.push(
      `${criticalFindings} critical finding(s) require resolution.`,
    );
  }


  if (
    evidenceScore <
    50
  ) {
    blockers.push(
      "Evidence coverage is below 50%.",
    );
  }


  if (
    verificationScore <
    50
  ) {
    blockers.push(
      "Verification coverage is below 50%.",
    );
  }


  if (
    machineryCount ===
    0
  ) {
    blockers.push(
      "Machinery register is empty.",
    );
  }


  /* ==========================================================
     DECISION
  ========================================================== */

  let decision: MachineryScore15Band =
    "conditional";


  if (
    criticalFindings >
    0
  ) {
    decision =
      "critical_risk";
  } else if (
    overallScore <
    50
  ) {
    decision =
      "high_risk";
  } else if (
    overallScore <
    70
  ) {
    decision =
      "conditional";
  } else if (
    overallScore <
    85
  ) {
    decision =
      "ready";
  } else {
    decision =
      "strong";
  }


  return {
    overallScore,

    capabilityScore,

    evidenceScore,

    verificationScore,

    findingScore,

    machineryCount,

    assessedMachinery,

    criticalFindings,

    majorFindings,

    openFindings,

    closedFindings,

    decision,

    components,

    strengths,

    gaps,

    blockers,
  };
}


/* ============================================================
   RECORD HELPERS
============================================================ */

function MachineryScore15HasText(
  record: MachineryRecord,
  key: string,
): boolean {
  const value =
    (
      record as unknown as Record<
        string,
        unknown
      >
    )[key];


  return (
    typeof value ===
      "string" &&
    value.trim()
      .length >
      0
  );
}


function MachineryScore15HasPositiveNumber(
  record: MachineryRecord,
  key: string,
): boolean {
  const value =
    (
      record as unknown as Record<
        string,
        unknown
      >
    )[key];


  if (
    typeof value ===
    "number"
  ) {
    return value >
      0;
  }


  if (
    typeof value ===
    "string"
  ) {
    const number =
      Number(value);

    return (
      Number.isFinite(
        number,
      ) &&
      number > 0
    );
  }


  return false;
}


/* ============================================================
   SCORE BAND
============================================================ */

function MachineryScore15Band(
  score: number,
): MachineryScore15Band {
  if (
    score <
    40
  ) {
    return "critical_risk";
  }


  if (
    score <
    60
  ) {
    return "high_risk";
  }


  if (
    score <
    75
  ) {
    return "conditional";
  }


  if (
    score <
    90
  ) {
    return "ready";
  }


  return "strong";
}


/* ============================================================
   DECISION LABEL
============================================================ */

function MachineryScore15DecisionLabel(
  decision: MachineryScore15Band,
): string {
  switch (
    decision
  ) {
    case "critical_risk":
      return "Critical Risk";

    case "high_risk":
      return "High Risk";

    case "conditional":
      return "Conditional Readiness";

    case "ready":
      return "Ready";

    case "strong":
      return "Strong Readiness";

    default:
      return "Not Assessed";
  }
}


/* ============================================================
   RECOMMENDATION
============================================================ */

function MachineryScore15Recommendation(
  result: MachineryScore15Result,
): string {
  if (
    result.decision ===
    "critical_risk"
  ) {
    return "Do not treat machinery capability as assessment-ready until critical risks are resolved and re-verified.";
  }


  if (
    result.decision ===
    "high_risk"
  ) {
    return "Additional evidence, verification and corrective action are required before readiness can be established.";
  }


  if (
    result.decision ===
    "conditional"
  ) {
    return "Machinery capability is conditionally assessed; close identified gaps before final submission or external review.";
  }


  if (
    result.decision ===
    "ready"
  ) {
    return "Machinery capability appears assessment-ready subject to applicable requirements and final assessor verification.";
  }


  if (
    result.decision ===
    "strong"
  ) {
    return "Machinery capability demonstrates strong documented and verified readiness.";
  }


  return "Machinery assessment has not yet been sufficiently established.";
}


/* ============================================================
   DECISION BADGE
============================================================ */

function MachineryScore15DecisionBadge({
  decision,
}: {
  decision: MachineryScore15Band;
}) {
  const className =
    decision ===
    "critical_risk"
      ? "border-red-300/20 bg-red-300/[0.06] text-red-200"
      : decision ===
          "high_risk"
        ? "border-orange-300/20 bg-orange-300/[0.06] text-orange-200"
        : decision ===
            "conditional"
          ? "border-amber-300/20 bg-amber-300/[0.06] text-amber-200"
          : decision ===
              "ready"
            ? "border-emerald-300/20 bg-emerald-300/[0.06] text-emerald-200"
            : decision ===
                "strong"
              ? "border-cyan-300/20 bg-cyan-300/[0.06] text-cyan-200"
              : "border-white/[0.08] bg-white/[0.03] text-white/30";


  return (
    <div
      className={`rounded-xl border px-5 py-4 text-center ${className}`}
    >

      <div className="text-[7px] font-bold uppercase tracking-[0.15em] opacity-60">
        Assessment Decision
      </div>

      <div className="mt-1 text-sm font-semibold">
        {MachineryScore15DecisionLabel(
          decision,
        )}
      </div>

    </div>
  );
}


