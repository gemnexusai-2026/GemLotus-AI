      evidenceRecords,
    );

  const findingScore =
    MachineryScore10FindingScore(
      findings,
    );


  const identityScore =
    records.length >
    0
      ? 100
      : 0;


  const physicalScore =
    MachineryScore10PhysicalScore(
      records,
    );


  const operationalScore =
    MachineryScore10OperationalScore(
      records,
    );


  return [
    {
      code:
        "identity",
