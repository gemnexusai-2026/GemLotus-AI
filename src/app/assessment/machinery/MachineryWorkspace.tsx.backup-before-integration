/* ============================================================
   VERIFICATION SUMMARY
============================================================ */

function MachineryEvidence9VerificationSummary({
  total,
  accepted,
  pending,
  needsReview,
  rejected,
}: {
  total: number;
  accepted: number;
  pending: number;
  needsReview: number;
  rejected: number;
}) {
  const verified =
    accepted;

  const verificationRate =
    total === 0
      ? 0
      : Math.round(
          (verified /
            total) *
            100,
        );


  const blocked =
    rejected >
      0 ||
    needsReview >
      0;


  return (
    <div className="rounded-2xl border border-cyan-300/10 bg-cyan-300/[0.025] p-5">

      <div className="text-[8px] font-bold uppercase tracking-[0.18em] text-cyan-300/50">
        Verification Summary
      </div>

      <h4 className="mt-1 text-sm font-semibold text-white/70">
        Evidence Verification Readiness
      </h4>


      <div className="mt-5 grid gap-4 lg:grid-cols-[1fr_1fr]">

        <div className="rounded-xl border border-white/[0.06] bg-black/[0.12] p-4">

          <div className="flex items-center justify-between">

            <span className="text-[7px] font-bold uppercase tracking-[0.13em] text-white/20">
              Verification Coverage
            </span>

            <span className="text-xl font-semibold text-cyan-200">
              {verificationRate}%
            </span>

          </div>


          <div className="mt-3 h-2 overflow-hidden rounded-full bg-white/[0.06]">

            <div
              className="h-full rounded-full bg-cyan-300"
              style={{
                width:
                  `${verificationRate}%`,
              }}
            />

          </div>


          <div className="mt-3 text-[8px] leading-5 text-white/25">
            {accepted} accepted out of {total} total
            evidence records.
          </div>

        </div>


        <div
          className={`rounded-xl border p-4 ${
            blocked
              ? "border-amber-300/10 bg-amber-300/[0.025]"
              : "border-emerald-300/10 bg-emerald-300/[0.025]"
          }`}
        >

          <div className="text-[7px] font-bold uppercase tracking-[0.13em] text-white/20">
            Verification State
          </div>

          <div
            className={`mt-2 text-sm font-semibold ${
              blocked
                ? "text-amber-200"
                : "text-emerald-200"
            }`}
          >
            {blocked
              ? "Attention Required"
              : "Verification Clear"}
          </div>

          <p className="mt-2 text-[8px] leading-5 text-white/25">
            {rejected > 0
              ? `${rejected} evidence record(s) rejected.`
              : needsReview > 0
              ? `${needsReview} evidence record(s) require review.`
              : pending > 0
              ? `${pending} evidence record(s) remain pending.`
              : "All registered evidence records are accepted."}
          </p>

        </div>

      </div>

    </div>
  );
}


/* ============================================================
   MACHINE NAME
============================================================ */

function MachineryEvidence9MachineName(
  record: MachineryRecord,
  index: number,
): string {
  if (
    "name" in
      record &&
    typeof record.name ===
      "string" &&
    record.name.trim()
  ) {
    return record.name;
  }

  if (
    "machineName" in
      record &&
    typeof record.machineName ===
      "string" &&
    record.machineName.trim()
  ) {
    return record.machineName;
  }

  return `Machinery #${
    index + 1
  }`;
}


/* ============================================================
   LABEL FORMATTER
============================================================ */

function MachineryEvidence9Label(
  value: string,
): string {
  return value
    .replace(
      /_/g,
      " ",
    )
    .replace(
      /\b\w/g,
      (character) =>
        character.toUpperCase(),
    );
}

/* ============================================================
   PART 10 — MACHINERY FINAL SCORE & READINESS ENGINE
   ------------------------------------------------------------
   Purpose:
   - Machinery capability score
   - Evidence score
   - Verification score
   - Finding/risk impact
   - Final readiness
   - Risk classification
   - Compliance summary
   - Assessor recommendation
   - Final decision snapshot
   - No database/schema assumptions
   - No duplicate generic helper names
============================================================ */


/* ============================================================
   TYPES
============================================================ */

type MachineryScore10Risk =
  | "low"
  | "moderate"
  | "high"
  | "critical";

type MachineryScore10Readiness =
  | "ready"
  | "conditionally_ready"
  | "needs_improvement"
  | "not_ready";

type MachineryScore10Dimension = {
  code: string;
  name: string;
  description: string;
  weight: number;
  score: number;
  status: string;
};

type MachineryScore10Finding = {
  severity:
    | "observation"
    | "minor"
    | "major"
    | "critical";

  status:
    | "open"
    | "in_progress"
    | "resolved"
    | "accepted";
};

type MachineryScore10Result = {
  capabilityScore: number;
  evidenceScore: number;
  verificationScore: number;
  findingScore: number;
  finalScore: number;
  risk: MachineryScore10Risk;
  readiness: MachineryScore10Readiness;
  dimensions: MachineryScore10Dimension[];
  openFindings: number;
  criticalFindings: number;
  recommendation: string;
};


/* ============================================================
   MAIN FINAL SCORE WORKSPACE
============================================================ */

function MachineryScore10Workspace({
  records,
}: {
  records: MachineryRecord[];
}) {
  const [
    evidenceRecords,
    setEvidenceRecords,
  ] = useState<
    MachineryScore10EvidenceItem[]
  >([]);


  const [
    findings,
    setFindings,
  ] = useState<
    MachineryScore10Finding[]
  >([]);


  const [
    assessorRemarks,
    setAssessorRemarks,
  ] = useState("");


  const result =
    MachineryScore10Calculate(
      records,
      evidenceRecords,
      findings,
    );


  function addEvidenceRecord() {
    setEvidenceRecords(
      (current) => [
        ...current,
        {
          verification:
            "pending",
        },
      ],
    );
  }


  function setEvidenceStatus(
    index: number,
    status:
      | "pending"
      | "accepted"
      | "rejected"
      | "needs_review",
  ) {
    setEvidenceRecords(
      (current) =>
        current.map(
          (
            item,
            currentIndex,
          ) =>
            currentIndex ===
            index
              ? {
                  ...item,
                  verification:
                    status,
                }
              : item,
        ),
    );
  }


  function addFindingRecord(
    severity:
      | "observation"
      | "minor"
      | "major"
      | "critical",
  ) {
    setFindings(
      (current) => [
        ...current,
        {
          severity,
          status:
            "open",
        },
      ],
    );
  }


  return (
    <div className="space-y-6">

      {/* ======================================================
         HEADER
      ====================================================== */}

      <div className="rounded-2xl border border-cyan-300/10 bg-cyan-300/[0.025] p-5">

        <div className="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">

          <div>

            <div className="text-[8px] font-bold uppercase tracking-[0.20em] text-cyan-300/50">
              Step 10 • Final Machinery Assessment
            </div>

            <h3 className="mt-1 text-lg font-semibold text-white">
              Machinery Readiness & Risk Engine
            </h3>

            <p className="mt-2 max-w-3xl text-[10px] leading-6 text-white/30">
              Consolidated assessment of machinery
              capability, supporting evidence,
              verification status, findings and
              operational readiness.
            </p>

          </div>


          <MachineryScore10ReadinessBadge
            readiness={
              result.readiness
            }
          />

        </div>

      </div>


      {/* ======================================================
         FINAL SCORE
      ====================================================== */}

      <div className="grid gap-4 lg:grid-cols-[1.2fr_1fr]">

        <MachineryScore10FinalScoreCard
          result={
            result
          }
        />

        <MachineryScore10RiskCard
          risk={
            result.risk
          }
          openFindings={
            result.openFindings
          }
          criticalFindings={
            result.criticalFindings
          }
        />

      </div>


      {/* ======================================================
         DIMENSION SCORECARD
      ====================================================== */}

      <div className="rounded-2xl border border-white/[0.07] bg-black/[0.13] p-5">

        <div className="text-[8px] font-bold uppercase tracking-[0.18em] text-white/30">
          Assessment Dimensions
        </div>

        <h4 className="mt-1 text-sm font-semibold text-white/70">
          Machinery Capability Scorecard
        </h4>


        <div className="mt-5 space-y-3">

          {result.dimensions.map(
            (
              dimension,
            ) => (
              <MachineryScore10DimensionRow
                key={
                  dimension.code
                }
                dimension={
                  dimension
                }
              />
            ),
          )}

        </div>

      </div>


      {/* ======================================================
         EVIDENCE STATUS
      ====================================================== */}

      <div className="rounded-2xl border border-white/[0.07] bg-black/[0.13] p-5">

        <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">

