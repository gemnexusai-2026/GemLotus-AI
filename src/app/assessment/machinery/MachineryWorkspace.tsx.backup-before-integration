   - No duplicate helper names
   - No arbitrary MachineryRecord string indexing
   - Reuses existing MachineryRecord helpers where possible
   - Self-contained audit layer
============================================================ */

type MachineryAudit7Severity =
| "observation"
| "minor"
| "major"
| "critical";

type MachineryAudit7Status =
| "open"
| "in_progress"
| "resolved"
| "accepted";

type MachineryAudit7Disposition =
| "ready"
| "conditionally_ready"
| "needs_improvement"
| "not_ready";

type MachineryAudit7Finding = {
id: string;
title: string;
description: string;
severity: MachineryAudit7Severity;
status: MachineryAudit7Status;
recommendation: string;
