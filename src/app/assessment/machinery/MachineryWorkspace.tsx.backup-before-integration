/* ============================================================
   LABEL FORMATTER
============================================================ */

function MachineryReport11Label(
  value: string,
): string {
  return value
    .replace(
      /_/g,
      " ",
    )
    .replace(
      /\b\w/g,
      (
        character,
      ) =>
        character.toUpperCase(),
    );
}

/* ============================================================
   PART 12 — VALIDATION & SUBMISSION GATE
   ------------------------------------------------------------
   Purpose:
   - Final pre-submission validation
   - Required-field validation
   - Machinery register validation
   - Physical verification validation
   - Operational verification validation
   - Evidence readiness validation
   - Finding validation
   - Corrective-action validation
   - Assessor identity validation
   - Conclusion validation
   - Submission blockers
   - Pass / Conditional / Blocked decision
   - Final submission confirmation
   - No database/schema assumptions
   - Additive layer only
============================================================ */


/* ============================================================
   TYPES
============================================================ */

type MachineryGate12Severity =
  | "info"
  | "warning"
  | "blocker"
  | "critical";

type MachineryGate12Category =
  | "machinery"
  | "verification"
  | "evidence"
  | "findings"
  | "corrective_action"
  | "assessor"
  | "conclusion"
  | "assessment";

type MachineryGate12Decision =
  | "pass"
  | "conditional"
  | "blocked";

type MachineryGate12Issue = {
  id: string;
  category: MachineryGate12Category;
  severity: MachineryGate12Severity;
  title: string;
  description: string;
  resolution: string;
};

type MachineryGate12Result = {
  decision: MachineryGate12Decision;
  completionPercent: number;
  blockers: MachineryGate12Issue[];
  warnings: MachineryGate12Issue[];
  information: MachineryGate12Issue[];
  totalChecks: number;
  passedChecks: number;
};


/* ============================================================
   MAIN VALIDATION GATE
============================================================ */

function MachineryGate12Workspace({
  records,
}: {
  records: MachineryRecord[];
}) {
  const [
    assessorName,
    setAssessorName,
  ] = useState("");

  const [
    assessorDesignation,
    setAssessorDesignation,
  ] = useState("");

  const [
    assessmentDate,
    setAssessmentDate,
  ] = useState("");

  const [
    conclusion,
    setConclusion,
  ] = useState("");

  const [
    evidenceCount,
    setEvidenceCount,
  ] = useState(0);

  const [
    acceptedEvidence,
    setAcceptedEvidence,
  ] = useState(0);

  const [
    pendingEvidence,
    setPendingEvidence,
  ] = useState(0);

  const [
    rejectedEvidence,
    setRejectedEvidence,
  ] = useState(0);

  const [
    openFindings,
    setOpenFindings,
  ] = useState(0);

  const [
    majorFindings,
    setMajorFindings,
  ] = useState(0);

  const [
    criticalFindings,
    setCriticalFindings,
  ] = useState(0);

  const [
    openCorrectiveActions,
    setOpenCorrectiveActions,
  ] = useState(0);

  const [
    completedCorrectiveActions,
    setCompletedCorrectiveActions,
  ] = useState(0);

  const [
    submitted,
    setSubmitted,
  ] = useState(false);


  const validation =
    MachineryGate12Validate({
      records,
      assessorName,
      assessorDesignation,
      assessmentDate,
      conclusion,
      evidenceCount,
      acceptedEvidence,
      pendingEvidence,
      rejectedEvidence,
      openFindings,
      majorFindings,
      criticalFindings,
      openCorrectiveActions,
      completedCorrectiveActions,
    });


  function resetSubmission() {
    setSubmitted(
      false,
    );
  }


  function submitAssessment() {
    if (
      validation.decision ===
      "blocked"
    ) {
      return;
    }

    setSubmitted(
      true,
    );
  }


  return (
    <div className="space-y-6">

      {/* ======================================================
         HEADER
      ====================================================== */}

      <div className="rounded-2xl border border-cyan-300/10 bg-cyan-300/[0.025] p-6">

        <div className="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">

          <div>

            <div className="text-[8px] font-bold uppercase tracking-[0.22em] text-cyan-300/50">
              Step 12 • Submission Gate
            </div>

            <h3 className="mt-2 text-xl font-semibold text-white">
              Machinery Assessment Validation
            </h3>

            <p className="mt-2 max-w-3xl text-[10px] leading-6 text-white/30">
              Final validation before the machinery
              assessment can be treated as ready for
              submission or review.
            </p>

          </div>


          <MachineryGate12DecisionBadge
            decision={
              validation.decision
            }
          />

        </div>

      </div>


      {/* ======================================================
         DECISION CARD
      ====================================================== */}

      <MachineryGate12DecisionCard
        result={
          validation
        }
      />


      {/* ======================================================
         VALIDATION PROGRESS
      ====================================================== */}

      <div className="rounded-2xl border border-white/[0.07] bg-black/[0.13] p-5">

        <div className="flex items-center justify-between">

          <div>

            <div className="text-[8px] font-bold uppercase tracking-[0.18em] text-white/30">
              Validation Coverage
            </div>

            <div className="mt-1 text-sm font-semibold text-white/65">
              Pre-Submission Checks
            </div>

          </div>


          <div className="text-xl font-semibold text-cyan-200">
            {validation.completionPercent}%
          </div>

        </div>


        <div className="mt-4 h-2 overflow-hidden rounded-full bg-white/[0.06]">

          <div
            className="h-full rounded-full bg-cyan-300"
            style={{
              width:
                `${validation.completionPercent}%`,
            }}
          />

        </div>


        <div className="mt-4 grid gap-3 sm:grid-cols-3">

          <MachineryGate12Metric
            label="Total Checks"
            value={
              String(
                validation.totalChecks,
              )
            }
          />

          <MachineryGate12Metric
            label="Passed Checks"
            value={
              String(
                validation.passedChecks,
              )
            }
          />

          <MachineryGate12Metric
            label="Blockers"
            value={
              String(
                validation.blockers.length,
              )
            }
          />

        </div>

      </div>


      {/* ======================================================
         ASSESSOR INFORMATION
      ====================================================== */}

      <div className="rounded-2xl border border-white/[0.07] bg-black/[0.13] p-5">

        <div className="text-[8px] font-bold uppercase tracking-[0.18em] text-white/30">
          Assessment Identity
        </div>

        <h4 className="mt-1 text-sm font-semibold text-white/70">
          Assessor Information
        </h4>


        <div className="mt-5 grid gap-4 md:grid-cols-3">

          <MachineryGate12Input
            label="Assessor Name"
            value={
              assessorName
            }
            onChange={
              setAssessorName
            }
            required
          />


          <MachineryGate12Input
            label="Designation"
            value={
              assessorDesignation
            }
            onChange={
              setAssessorDesignation
            }
            required
          />


          <MachineryGate12Input
            label="Assessment Date"
            type="date"
            value={
              assessmentDate
            }
            onChange={
              setAssessmentDate
            }
            required
          />

        </div>

      </div>


      {/* ======================================================
         MACHINERY CHECKS
      ====================================================== */}

      <MachineryGate12Section
        title="Machinery Register Validation"
        description="Checks whether the machinery register contains usable assessment records."
        issues={
          validation.blockers.filter(
            (issue) =>
              issue.category ===
              "machinery",
          ).concat(
            validation.warnings.filter(
              (issue) =>
                issue.category ===
                "machinery",
            ),
          )
        }
      />


      {/* ======================================================
         VERIFICATION CHECKS
      ====================================================== */}

      <MachineryGate12Section
        title="Verification Validation"
        description="Checks physical and operational verification coverage."
        issues={
          validation.blockers.filter(
            (issue) =>
              issue.category ===
              "verification",
          ).concat(
            validation.warnings.filter(
              (issue) =>
                issue.category ===
                "verification",
            ),
          )
        }
      />


      {/* ======================================================
         EVIDENCE CHECKS
      ====================================================== */}

      <div className="rounded-2xl border border-white/[0.07] bg-black/[0.13] p-5">

        <div className="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">

          <div>

            <div className="text-[8px] font-bold uppercase tracking-[0.18em] text-white/30">
              Evidence Readiness
            </div>

            <h4 className="mt-1 text-sm font-semibold text-white/70">
              Evidence Verification State
