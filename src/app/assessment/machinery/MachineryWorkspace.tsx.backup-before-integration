/* ============================================================
   TRACEABILITY CALCULATOR
============================================================ */

function MachineryTrace13Calculate(
  records: MachineryRecord[],
  evidence: MachineryTrace13Evidence[],
  verifications: MachineryTrace13Verification[],
): MachineryTrace13Result {
  const totalMachinery =
    records.length;


  if (
    totalMachinery ===
    0
  ) {
    return {
      totalMachinery:
        0,

      machineryWithEvidence:
        0,

      machineryWithVerification:
        0,

      evidenceCoverage:
        0,

      verificationCoverage:
        0,

      traceabilityCoverage:
        0,

      gaps: [
        "No machinery records are available for traceability.",
      ],
    };
  }


  const evidenceMachineSet =
    new Set(
      evidence.map(
        (item) =>
          item.machineryIndex,
      ),
    );


  const verificationMachineSet =
    new Set(
      verifications.map(
        (item) =>
          item.machineryIndex,
      ),
    );


  const machineryWithEvidence =
    evidenceMachineSet.size;


  const machineryWithVerification =
    verificationMachineSet.size;


  const evidenceCoverage =
    Math.round(
      (machineryWithEvidence /
        totalMachinery) *
        100,
    );


  const verificationCoverage =
    Math.round(
      (machineryWithVerification /
        totalMachinery) *
        100,
    );


  const traceableCount =
    records.filter(
      (_, index) =>
        evidenceMachineSet.has(
          index,
        ) &&
        verificationMachineSet.has(
          index,
        ),
    ).length;


  const traceabilityCoverage =
    Math.round(
      (traceableCount /
        totalMachinery) *
        100,
    );


  const gaps: string[] =
    [];


  records.forEach(
    (
      record,
      index,
    ) => {
      const name =
        MachineryTrace13MachineName(
          record,
        );


      if (
        !evidenceMachineSet.has(
          index,
        )
      ) {
        gaps.push(
          `${name}: no linked evidence record.`,
        );
      }


      if (
        !verificationMachineSet.has(
          index,
        )
      ) {
        gaps.push(
          `${name}: no verification record.`,
        );
      }
    },
  );


  return {
    totalMachinery,
    machineryWithEvidence,
    machineryWithVerification,
    evidenceCoverage,
    verificationCoverage,
    traceabilityCoverage,
    gaps,
  };
}


/* ============================================================
   MACHINE NAME HELPER
============================================================ */

function MachineryTrace13MachineName(
  record: MachineryRecord,
): string {
  if (
    "name" in
      record &&
    typeof record.name ===
      "string" &&
    record.name.trim()
      .length >
      0
  ) {
    return record.name;
  }


  if (
    "machineName" in
      record &&
    typeof record.machineName ===
      "string" &&
    record.machineName.trim()
      .length >
      0
  ) {
    return record.machineName;
  }


  if (
    "equipmentName" in
      record &&
    typeof record.equipmentName ===
      "string" &&
    record.equipmentName.trim()
      .length >
      0
  ) {
    return record.equipmentName;
  }


  return "Unnamed Machinery";
}


