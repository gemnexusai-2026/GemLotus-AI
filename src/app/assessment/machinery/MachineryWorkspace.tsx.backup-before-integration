/* ============================================================
   SELECT SMALL
============================================================ */

function SelectSmall({
  onAdd,
}: {
  onAdd: (
    type: EvidenceRecord["type"],
  ) => void;
}) {
  return (
    <select
      defaultValue=""
      onChange={(event) => {
        const value =
          event.target
            .value;

        if (!value) {
          return;
        }

