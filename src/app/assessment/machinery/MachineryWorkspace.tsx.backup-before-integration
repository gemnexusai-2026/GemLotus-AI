/* ============================================================
   EVIDENCE REVIEW STATUS
============================================================ */

type EvidenceReviewDecision =
  | "pending"
  | "accepted"
  | "rejected"
  | "needs_review";


/* ============================================================
   EVIDENCE REVIEW RECORD
============================================================ */

type EvidenceReviewRecord = {
  category: MachineryEvidenceCategory;
  decision: EvidenceReviewDecision;
  reviewerRemarks: string;
};


/* ============================================================
   EVIDENCE REVIEW WORKSPACE
============================================================ */

function MachineryEvidenceReviewWorkspace({
  records,
}: {
  records: MachineryRecord[];
}) {
  const [
    selectedIndex,
    setSelectedIndex,
  ] = useState(0);

  const [
    reviewRecords,
    setReviewRecords,
  ] = useState<
    Record<
      number,
      EvidenceReviewRecord[]
    >
  >({});

  const [
    finalRemarks,
    setFinalRemarks,
  ] = useState("");

  const selectedRecord =
    records[selectedIndex];

  if (records.length === 0) {
    return (
      <EmptyState
        title="No machinery records"
        description="Machinery records are required before evidence review can begin."
        actionLabel="Return To Machinery"
        onAction={() => {
          window.scrollTo({
            top: 0,
            behavior: "smooth",
          });
        }}
      />
    );
  }

  function getReviews(
    index: number,
  ): EvidenceReviewRecord[] {
    return (
      reviewRecords[index] ??
      MACHINERY_EVIDENCE_DEFINITIONS.map(
        (item) => ({
          category:
            item.category,
          decision:
            "pending",
          reviewerRemarks:
            "",
        }),
      )
    );
  }

  function updateReview(
    index: number,
    category: MachineryEvidenceCategory,
    patch: Partial<EvidenceReviewRecord>,
  ) {
    const current =
      getReviews(index);

    const next =
      current.map(
        (item) =>
          item.category ===
          category
            ? {
                ...item,
                ...patch,
              }
            : item,
      );

    setReviewRecords(
      (currentRecords) => ({
        ...currentRecords,
        [index]: next,
      }),
    );
  }

  function calculateReadiness(
    index: number,
  ) {
    const record =
      records[index];

    const reviews =
      getReviews(index);

    const required =
      MACHINERY_EVIDENCE_DEFINITIONS.filter(
        (item) =>
          item.required,
      );

    const acceptedRequired =
      reviews.filter(
        (review) => {
          const definition =
            required.find(
              (item) =>
                item.category ===
                review.category,
            );

          return (
            definition &&
            review.decision ===
              "accepted"
          );
        },
      );

    const physical =
      getBoolean(
        record,
        "physicalVerification",
      );

    const rejected =
      reviews.some(
        (review) =>
          review.decision ===
          "rejected",
      );

    return {
      requiredCount:
        required.length,

      acceptedCount:
        acceptedRequired.length,

      physical,

      rejected,

      ready:
        acceptedRequired.length ===
          required.length &&
        physical &&
        !rejected,
    };
  }

  const readiness =
    calculateReadiness(
      selectedIndex,
    );

  return (
    <div className="space-y-6">

      {/* ======================================================
         HEADER
      ====================================================== */}

      <div className="rounded-2xl border border-white/[0.07] bg-black/[0.14] p-5">

        <div className="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">

          <div>

            <div className="text-[8px] font-bold uppercase tracking-[0.20em] text-cyan-300/50">
              Evidence Review
            </div>

            <h3 className="mt-1 text-lg font-semibold text-white">
              Machinery Verification Review
            </h3>

            <p className="mt-2 max-w-3xl text-[10px] leading-6 text-white/30">
              Review each evidence item independently
              before accepting the machinery record
              for assessment.
            </p>

          </div>

          <ReviewReadinessCard
            accepted={
              readiness.acceptedCount
            }
            required={
              readiness.requiredCount
            }
            physical={
              readiness.physical
            }
            ready={
              readiness.ready
            }
          />

        </div>

      </div>


      {/* ======================================================
         MACHINE SELECTOR
      ====================================================== */}

      <div className="rounded-2xl border border-white/[0.07] bg-black/[0.12] p-4">

        <div className="mb-3 text-[8px] font-bold uppercase tracking-[0.18em] text-white/30">
          Machinery Records
        </div>

        <div className="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">

          {records.map(
            (record, index) => {
              const active =
                index ===
                selectedIndex;

              const name =
                getMachineryDisplayName(
                  record,
                  index,
                );

              const verification =
                getString(
                  record,
                  "verificationStatus",
                );

              return (
                <button
                  key={getRecordKey(
                    record,
                    index,
                  )}
                  type="button"
                  onClick={() =>
                    setSelectedIndex(
                      index,
                    )
                  }
                  className={`rounded-xl border p-4 text-left transition ${
                    active
                      ? "border-cyan-300/20 bg-cyan-300/[0.06]"
                      : "border-white/[0.06] bg-white/[0.015] hover:bg-white/[0.03]"
                  }`}
                >

                  <div className="text-[10px] font-semibold text-white/70">
                    {name}
                  </div>

                  <div className="mt-1 text-[8px] text-white/25">
                    Machinery #{index + 1}
                  </div>

                  <div className="mt-3">
                    <VerificationBadge
                      status={
                        verification ||
                        "pending"
                      }
                    />
                  </div>

                </button>
              );
            },
          )}

        </div>

      </div>


      {/* ======================================================
         REVIEW ITEMS
      ====================================================== */}

      {selectedRecord && (
        <div className="rounded-2xl border border-white/[0.07] bg-black/[0.14] p-5">

          <div className="mb-5">

            <div className="text-[8px] font-bold uppercase tracking-[0.18em] text-white/30">
              Reviewing
            </div>

            <div className="mt-1 text-lg font-semibold text-white">
              {getMachineryDisplayName(
                selectedRecord,
                selectedIndex,
              )}
            </div>

          </div>

          <div className="space-y-3">

            {MACHINERY_EVIDENCE_DEFINITIONS.map(
              (definition) => {
                const review =
                  getReviews(
                    selectedIndex,
                  ).find(
                    (item) =>
                      item.category ===
                      definition.category,
                  ) ?? {
                    category:
                      definition.category,
                    decision:
                      "pending" as EvidenceReviewDecision,
                    reviewerRemarks:
                      "",
                  };

                return (
                  <EvidenceReviewRow
                    key={
                      definition.category
                    }
                    definition={
                      definition
                    }
                    review={review}
                    onDecisionChange={(
                      decision,
                    ) =>
                      updateReview(
                        selectedIndex,
                        definition.category,
                        {
                          decision,
                        },
                      )
                    }
                    onRemarksChange={(
                      reviewerRemarks,
                    ) =>
                      updateReview(
                        selectedIndex,
                        definition.category,
                        {
                          reviewerRemarks,
                        },
                      )
                    }
                  />
                );
              },
            )}

          </div>

        </div>
      )}


      {/* ======================================================
         FINAL REVIEW
      ====================================================== */}

      <div className="rounded-2xl border border-cyan-300/10 bg-cyan-300/[0.025] p-5">

        <SectionHeading
          number="FINAL"
          title="Assessment Review"
          description="Record the final assessor observation before this machinery record is considered ready."
        />

        <div className="mt-5 grid gap-4 md:grid-cols-3">

          <ReviewCheck
            label="Physical machine verified"
            value={
              readiness.physical
            }
          />

          <ReviewCheck
            label="Required evidence accepted"
            value={
              readiness.acceptedCount ===
              readiness.requiredCount
            }
          />

          <ReviewCheck
            label="No rejected evidence"
            value={
              !readiness.rejected
            }
          />

        </div>

        <div className="mt-5">

          <SafeTextArea
            label="Final Assessment Remarks"
            value={finalRemarks}
            onChange={
              setFinalRemarks
            }
          />

        </div>

        <div className="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">

          <div>
            <div className="text-[8px] font-bold uppercase tracking-[0.16em] text-white/25">
              Current Decision
            </div>

            <div
              className={`mt-1 text-sm font-semibold ${
                readiness.ready
                  ? "text-emerald-200"
                  : "text-amber-200"
              }`}
            >
              {readiness.ready
                ? "Ready for Assessment"
                : "Verification Incomplete"}
            </div>
          </div>

          <button
            type="button"
            disabled={
              !readiness.ready
            }
            className="rounded-xl bg-gradient-to-r from-cyan-400 to-blue-500 px-5 py-3 text-[9px] font-bold uppercase tracking-[0.14em] text-[#031020] transition hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-30"
          >
            Mark Machinery Ready
          </button>

        </div>

      </div>

    </div>
  );
}


