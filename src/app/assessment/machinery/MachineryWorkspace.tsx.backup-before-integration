            <textarea
              rows={3}
              value={
                item.correctiveAction
              }
              onChange={(event) =>
                onUpdate({
                  correctiveAction:
                    event.target
                      .value,
                })
              }
              className="w-full resize-y rounded-xl border border-amber-300/10 bg-amber-300/[0.02] px-4 py-3 text-[10px] leading-5 text-white outline-none focus:border-amber-300/25"
            />

          </label>
        )}

      </div>

    </div>
  );
}


