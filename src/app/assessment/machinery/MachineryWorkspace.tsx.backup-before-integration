/* ============================================================
   CALCULATOR
============================================================ */

function MachineryFindings14Calculate(
  records: MachineryRecord[],
  findings: MachineryFinding14Record[],
) {
  const totalFindings =
    findings.length;


  const observations =
    findings.filter(
      (item) =>
        item.classification ===
        "observation",
    ).length;


  const minor =
    findings.filter(
      (item) =>
        item.classification ===
        "minor",
    ).length;


  const major =
    findings.filter(
      (item) =>
        item.classification ===
        "major",
    ).length;


  const critical =
    findings.filter(
      (item) =>
        item.classification ===
        "critical",
    ).length;


  const closedFindings =
    findings.filter(
      (item) =>
        item.status ===
        "closed",
    ).length;


  const openFindings =
    findings.filter(
      (item) =>
        item.status !==
          "closed" &&
        item.status !==
          "rejected",
    ).length;


  const machinesAffected =
    new Set(
      findings.map(
        (item) =>
          item.machineryIndex,
      ),
    ).size;


  const coverage =
    records.length ===
    0
      ? 0
      : Math.round(
          (machinesAffected /
            records.length) *
            100,
        );


  return {
    totalFindings,
    observations,
    minor,
    major,
    critical,
    closedFindings,
    openFindings,
    machinesAffected,
    coverage,
  };
}


/* ============================================================
   MACHINE NAME
============================================================ */

function MachineryFinding14MachineName(
  record: MachineryRecord,
): string {
  if (
    "name" in
      record &&
    typeof record.name ===
      "string" &&
    record.name.trim()
      .length >
      0
  ) {
    return record.name;
  }


  if (
    "machineName" in
      record &&
    typeof record.machineName ===
      "string" &&
    record.machineName.trim()
      .length >
      0
  ) {
    return record.machineName;
  }


  if (
    "equipmentName" in
      record &&
    typeof record.equipmentName ===
      "string" &&
    record.equipmentName.trim()
      .length >
      0
  ) {
    return record.equipmentName;
  }


  return "Unnamed Machinery";
}


