/* ============================================================
   PHYSICAL SCORE
============================================================ */

function MachineryScore10PhysicalScore(
  records: MachineryRecord[],
): number {
  if (
    records.length ===
    0
  ) {
    return 0;
  }


  const verified =
    records.filter(
      (record) =>
        "physicalVerification" in
          record &&
        record.physicalVerification ===
          true,
    ).length;


  return Math.round(
    (verified /
      records.length) *
      100,
  );
}


/* ============================================================
   OPERATIONAL SCORE
============================================================ */

function MachineryScore10OperationalScore(
  records: MachineryRecord[],
): number {
  if (
    records.length ===
    0
  ) {
    return 0;
  }


  const operational =
    records.filter(
      (record) =>
        "operationalDuringVisit" in
          record &&
        record.operationalDuringVisit ===
          true,
    ).length;


  return Math.round(
    (operational /
      records.length) *
      100,
  );
}


/* ============================================================
   DIMENSION STATUS
============================================================ */

function MachineryScore10DimensionStatus(
  score: number,
): string {
  if (
    score >=
    85
  ) {
    return "Strong";
  }

  if (
    score >=
    70
  ) {
    return "Acceptable";
  }

  if (
    score >=
    50
  ) {
    return "Needs Improvement";
  }

  return "Weak";
}


/* ============================================================
   RISK ENGINE
============================================================ */

function MachineryScore10Risk(
  score: number,
  criticalFindings: number,
  findings: MachineryScore10Finding[],
  evidenceRecords: MachineryScore10EvidenceItem[],
): MachineryScore10Risk {
  if (
    criticalFindings >
    0
  ) {
    return "critical";
  }


  const rejected =
    evidenceRecords.filter(
      (item) =>
        item.verification ===
        "rejected",
    ).length;


  if (
    rejected >
    0
  ) {
    return "high";
  }


  const unresolvedMajor =
    findings.filter(
      (finding) =>
        finding.severity ===
          "major" &&
        finding.status !==
          "resolved" &&
        finding.status !==
          "accepted",
    ).length;


  if (
    unresolvedMajor >
    0
  ) {
    return "high";
  }


  if (
    score <
    50
  ) {
    return "high";
  }


  if (
    score <
    70
  ) {
    return "moderate";
  }


  return "low";
}


/* ============================================================
   READINESS ENGINE
============================================================ */

function MachineryScore10Readiness(
  score: number,
  criticalFindings: number,
  evidenceRecords: MachineryScore10EvidenceItem[],
): MachineryScore10Readiness {
  if (
    criticalFindings >
    0
  ) {
    return "not_ready";
  }


  const rejected =
    evidenceRecords.filter(
      (item) =>
        item.verification ===
        "rejected",
    ).length;


  if (
    rejected >
    0
  ) {
    return "not_ready";
  }


  if (
    score >=
    80
  ) {
    return "ready";
  }


  if (
    score >=
    65
  ) {
    return "conditionally_ready";
  }


  if (
    score >=
    45
  ) {
    return "needs_improvement";
  }


  return "not_ready";
}


/* ============================================================
   RECOMMENDATION ENGINE
============================================================ */

function MachineryScore10Recommendation(
  readiness: MachineryScore10Readiness,
  risk: MachineryScore10Risk,
  score: number,
  evidenceRecords: MachineryScore10EvidenceItem[],
  criticalFindings: number,
): string {
  if (
    criticalFindings >
    0
  ) {
    return "Do not treat the machinery module as ready for final assessment acceptance until all critical findings are resolved and verified.";
  }


  const rejected =
    evidenceRecords.filter(
      (item) =>
        item.verification ===
        "rejected",
    ).length;


  if (
    rejected >
    0
  ) {
    return "Required evidence contains rejected records. Obtain acceptable supporting evidence and complete verification before final acceptance.";
  }


  if (
    readiness ===
    "ready"
  ) {
    return `Machinery capability is presently assessed as ready with a consolidated module score of ${score}%. Final acceptance should remain subject to overall assessment evidence and assessor verification.`;
  }


  if (
    readiness ===
    "conditionally_ready"
  ) {
    return `Machinery capability is conditionally ready at ${score}%. Outstanding evidence, verification or capability gaps should be closed before final submission.`;
  }


  if (
    readiness ===
    "needs_improvement"
  ) {
    return `Machinery capability requires improvement. The current consolidated score is ${score}%, and identified gaps should be addressed and re-verified.`;
  }


  return `Machinery capability is not ready for final acceptance at the current score of ${score}%. Additional evidence, verification and corrective action are required.`;
}


