/* ============================================================
   EVIDENCE AVAILABILITY
   ------------------------------------------------------------
   Known-property access only.
============================================================ */

function MachineryEvidence8EvidenceAvailable(
  record: MachineryRecord,
  category: string,
): boolean {
  if (
    category ===
    "machine_photo"
  ) {
    return (
      "photographAvailable" in
        record &&
      record.photographAvailable ===
        true
    );
  }


  if (
    category ===
    "nameplate_photo"
  ) {
    return (
      "nameplatePhotographAvailable" in
        record &&
      record.nameplatePhotographAvailable ===
        true
    );
  }


  if (
    category ===
    "serial_photo"
  ) {
    return (
      "serialEvidenceAvailable" in
        record &&
      record.serialEvidenceAvailable ===
        true
    );
  }


  if (
    category ===
    "ownership_document"
  ) {
    return (
      "purchaseDocumentAvailable" in
        record &&
      record.purchaseDocumentAvailable ===
        true
    );
  }


  if (
    category ===
    "purchase_invoice"
  ) {
    return (
      "invoiceAvailable" in
        record &&
      record.invoiceAvailable ===
        true
    );
  }


  if (
    category ===
    "maintenance_record"
  ) {
    const maintenance =
      "maintenanceAvailable" in
        record &&
      record.maintenanceAvailable ===
        true;

    const maintenanceRecord =
      "maintenanceRecordAvailable" in
        record &&
      record.maintenanceRecordAvailable ===
        true;

    return (
      maintenance ||
      maintenanceRecord
    );
  }


  if (
    category ===
    "calibration_record"
  ) {
    return (
      "calibrationRecordAvailable" in
        record &&
      record.calibrationRecordAvailable ===
        true
    );
  }


  if (
    category ===
    "machine_manual"
  ) {
    return (
      "manualAvailable" in
        record &&
      record.manualAvailable ===
        true
    );
  }


  if (
    category ===
    "other"
  ) {
    return (
      "otherEvidenceAvailable" in
        record &&
      record.otherEvidenceAvailable ===
        true
    );
  }


  return false;
}


/* ============================================================
   VERIFICATION STATUS
============================================================ */

function MachineryEvidence8VerificationStatus(
  record: MachineryRecord,
): string {
  if (
    "verificationStatus" in
      record &&
    typeof record.verificationStatus ===
      "string"
  ) {
    return record.verificationStatus;
  }

  return "pending";
}


/* ============================================================
   MACHINE NAME
============================================================ */

function MachineryEvidence8MachineName(
  record: MachineryRecord,
  index: number,
): string {
  if (
    "name" in
      record &&
    typeof record.name ===
      "string" &&
    record.name.trim()
  ) {
    return record.name;
  }


  if (
    "machineName" in
      record &&
    typeof record.machineName ===
      "string" &&
    record.machineName.trim()
  ) {
    return record.machineName;
  }


  return `Machinery #${
    index + 1
  }`;
}


