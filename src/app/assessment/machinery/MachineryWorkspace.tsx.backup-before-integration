/* ============================================================
 EVIDENCE WORKSPACE
============================================================ */

function MachineryEvidenceRegistry({
record,
}: {
record: MachineryRecord;
}) {
const [
  evidence,
  setEvidence,
] = useState<MachineryEvidenceItem[]>(
  () =>
    MACHINERY_EVIDENCE_DEFINITIONS.map(
      (definition, index) => ({
        id:
          `evidence-${index}-${definition.category}`,
        category:
          definition.category,
        title:
          definition.title,
        description:
          definition.description,
        required:
          definition.required,
        status:
          "not_uploaded",
        fileName: "",
        fileSize: 0,
        fileType: "",
      }),
    ),
);

const [
  selectedCategory,
  setSelectedCategory,
] =
  useState<MachineryEvidenceCategory | null>(
    null,
  );

const [
  message,
  setMessage,
] = useState("");

const requiredItems =
  evidence.filter(
    (item) => item.required,
  );

const completedRequired =
  requiredItems.filter(
    (item) =>
      item.status ===
        "selected" ||
      item.status ===
        "uploaded" ||
      item.status ===
        "verified",
  ).length;

const coverage =
  requiredItems.length === 0
    ? 0
    : Math.round(
        (completedRequired /
          requiredItems.length) *
          100,
      );

function handleFileSelection(
  category: MachineryEvidenceCategory,
  file: File | null,
) {
  if (!file) {
    return;
  }

  const definition =
    MACHINERY_EVIDENCE_DEFINITIONS.find(
      (item) =>
        item.category ===
        category,
    );

  if (!definition) {
    return;
  }

  const maxSize =
    25 * 1024 * 1024;

  if (file.size > maxSize) {
    setMessage(
      "File size exceeds the 25 MB assessment limit.",
    );

    return;
  }

  setEvidence(
    (current) =>
      current.map(
        (item) =>
          item.category ===
          category
            ? {
                ...item,
                status:
                  "selected",
                fileName:
                  file.name,
                fileSize:
                  file.size,
                fileType:
                  file.type,
              }
            : item,
      ),
  );

  setSelectedCategory(
    category,
  );

  setMessage(
    `${file.name} selected for ${definition.title}.`,
  );
}

function clearEvidence(
  category: MachineryEvidenceCategory,
) {
  setEvidence(
    (current) =>
      current.map(
        (item) =>
          item.category ===
          category
            ? {
                ...item,
                status:
                  "not_uploaded",
                fileName: "",
                fileSize: 0,
                fileType: "",
              }
            : item,
      ),
  );

  setMessage(
    "Evidence selection cleared.",
  );
}

return (
  <div className="space-y-6">

    {/* ======================================================
       HEADER
    ====================================================== */}

    <div className="rounded-2xl border border-cyan-300/10 bg-cyan-300/[0.025] p-5">

      <div className="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">

        <div>

          <div className="text-[8px] font-bold uppercase tracking-[0.20em] text-cyan-300/50">
            Evidence Registry
          </div>

          <h3 className="mt-1 text-lg font-semibold text-white">
            Machinery Evidence
          </h3>

          <p className="mt-2 max-w-2xl text-[10px] leading-5 text-white/30">
            Select the evidence associated with
            this machinery record. Actual storage
            and final upload processing can be
            connected to the assessment evidence
            service without changing this workflow.
          </p>

        </div>

        <EvidenceCoverage
          percentage={coverage}
        />

      </div>

    </div>


    {/* ======================================================
       MESSAGE
    ====================================================== */}

    {message && (
      <div className="rounded-xl border border-cyan-300/10 bg-cyan-300/[0.03] px-4 py-3 text-[9px] leading-5 text-cyan-200/70">
        {message}
      </div>
    )}


    {/* ======================================================
       EVIDENCE LIST
    ====================================================== */}

    <div className="space-y-3">

      {evidence.map(
        (item) => (
          <EvidenceRegistryRow
            key={item.id}
            item={item}
            selected={
              selectedCategory ===
              item.category
            }
            onSelect={() =>
              setSelectedCategory(
