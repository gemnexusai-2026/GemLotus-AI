"use client";

import {
  useMemo,
  useState,
} from "react";

import AssessmentSidebar from "@/components/assessment/AssessmentSidebar";

/* ============================================================
   MACHINERY WORKSPACE
   Enterprise Factory Assessment
   GEM / RITES EVIDENCE-FIRST DESIGN

   IMPORTANT:
   - This component is intentionally self-contained.
   - No dependency on machinery-types.ts
   - No dependency on machinery-engine.ts
   - No dependency on machinery-scoring.ts
   - Prevents cascading TypeScript errors while the module
     is being assembled sequentially.
============================================================ */

/* ============================================================
   TYPES
============================================================ */

type Props = {
  assessmentId: string;
  initialData?: Record<string, unknown> | null;
};

type Ownership =
  | "owned"
  | "leased"
  | "rented"
  | "shared";

type MachineStatus =
  | "operational"
  | "partially_operational"
  | "under_maintenance"
  | "not_operational";

type VerificationStatus =
  | "pending"
  | "verified"
  | "rejected"
  | "needs_review";

type EvidenceStatus =
  | "missing"
  | "uploaded"
  | "verified"
  | "rejected";

type MachineryRecord = {
  id: string;

  machineName: string;
  machineCategory: string;
  manufacturer: string;
  model: string;

  serialNumber: string;
  assetNumber: string;

  quantity: number;

  ownership: Ownership;

  yearOfManufacture: string;
  installationYear: string;

  capacity: string;
  capacityUnit: string;

  machineStatus: MachineStatus;

  productionUse: string;

  powerRequirement: string;
  powerUnit: string;

  operatorRequired: boolean;

  operatorCount: number;

  maintenanceAvailable: boolean;
  maintenanceFrequency: string;
  lastMaintenanceDate: string;

  calibrationRequired: boolean;
  calibrationAvailable: boolean;
  calibrationDate: string;
  calibrationExpiry: string;

  physicallyVerified: boolean;
  verificationStatus: VerificationStatus;

  evidenceStatus: EvidenceStatus;

  remarks: string;
};

type EvidenceRecord = {
  id: string;
  machineId: string;

  type:
    | "photo"
    | "document"
    | "certificate"
    | "video"
    | "other";

  name: string;

  status: EvidenceStatus;

  remarks: string;
};

/* ============================================================
   HELPERS
============================================================ */

function text(
  data: Record<string, unknown> | null | undefined,
  key: string,
): string {
  const value = data?.[key];

  if (
    value === null ||
    value === undefined
  ) {
    return "";
  }

  return String(value);
}

function bool(
  data: Record<string, unknown> | null | undefined,
  key: string,
): boolean {
  return Boolean(data?.[key]);
}

function numberValue(
  value: unknown,
  fallback = 0,
): number {
  const number = Number(value);

  return Number.isFinite(number)
    ? number
    : fallback;
}

function createId(): string {
  return `machine-${Date.now()}-${Math.random()
    .toString(36)
    .slice(2, 9)}`;
}

function createEvidenceId(): string {
  return `evidence-${Date.now()}-${Math.random()
    .toString(36)
    .slice(2, 9)}`;
}

function createMachine(): MachineryRecord {
  return {
    id: createId(),

    machineName: "",
    machineCategory: "",

    manufacturer: "",
    model: "",

    serialNumber: "",
    assetNumber: "",

    quantity: 1,

    ownership: "owned",

    yearOfManufacture: "",
    installationYear: "",

    capacity: "",
    capacityUnit: "",

    machineStatus: "operational",

    productionUse: "",

    powerRequirement: "",
    powerUnit: "kW",

    operatorRequired: true,
    operatorCount: 1,

    maintenanceAvailable: false,
    maintenanceFrequency: "",
    lastMaintenanceDate: "",

    calibrationRequired: false,
    calibrationAvailable: false,
    calibrationDate: "",
    calibrationExpiry: "",

    physicallyVerified: false,
    verificationStatus: "pending",

    evidenceStatus: "missing",

    remarks: "",
  };
}

/* ============================================================
   MAIN COMPONENT
============================================================ */

export default function MachineryWorkspace({
  assessmentId,
  initialData,
}: Props) {
  const [machines, setMachines] =
    useState<MachineryRecord[]>(() => {
      const value =
        initialData?.machinery_details;

      if (
        Array.isArray(value) &&
        value.length > 0
      ) {
        return value.map(
          (item, index) => {
            const record =
              item as Record<
                string,
                unknown
              >;

            return {
              ...createMachine(),

              id:
                text(record, "id") ||
                `machine-existing-${index}`,

              machineName:
                text(
                  record,
                  "machineName",
                ) ||
                text(
                  record,
                  "name",
                ),

              machineCategory:
                text(
                  record,
                  "machineCategory",
                ),

              manufacturer:
                text(
                  record,
                  "manufacturer",
                ),

              model:
                text(
                  record,
                  "model",
                ),

              serialNumber:
                text(
                  record,
                  "serialNumber",
                ),

              assetNumber:
                text(
                  record,
                  "assetNumber",
                ),

              quantity:
                numberValue(
                  record.quantity,
                  1,
                ),

              ownership:
                (
                  [
                    "owned",
                    "leased",
                    "rented",
                    "shared",
                  ] as string[]
                ).includes(
                  text(
                    record,
                    "ownership",
                  ),
                )
                  ? (text(
                      record,
                      "ownership",
                    ) as Ownership)
                  : "owned",

              yearOfManufacture:
                text(
                  record,
                  "yearOfManufacture",
                ),

              installationYear:
                text(
                  record,
                  "installationYear",
                ),

              capacity:
                text(
                  record,
                  "capacity",
                ),

              capacityUnit:
                text(
                  record,
                  "capacityUnit",
                ),

              machineStatus:
                (
                  [
                    "operational",
                    "partially_operational",
                    "under_maintenance",
                    "not_operational",
                  ] as string[]
                ).includes(
                  text(
                    record,
                    "machineStatus",
                  ),
                )
                  ? (text(
                      record,
                      "machineStatus",
                    ) as MachineStatus)
                  : "operational",

              productionUse:
                text(
                  record,
                  "productionUse",
                ),

              powerRequirement:
                text(
                  record,
                  "powerRequirement",
                ),

              powerUnit:
                text(
                  record,
                  "powerUnit",
                ) || "kW",

              operatorRequired:
                record.operatorRequired ===
                undefined
                  ? true
                  : bool(
                      record,
                      "operatorRequired",
                    ),

              operatorCount:
                numberValue(
                  record.operatorCount,
                  1,
                ),

              maintenanceAvailable:
                bool(
                  record,
                  "maintenanceAvailable",
                ),

              maintenanceFrequency:
                text(
                  record,
                  "maintenanceFrequency",
                ),

              lastMaintenanceDate:
                text(
                  record,
                  "lastMaintenanceDate",
                ),

              calibrationRequired:
                bool(
                  record,
                  "calibrationRequired",
                ),

              calibrationAvailable:
                bool(
                  record,
                  "calibrationAvailable",
                ),

              calibrationDate:
                text(
                  record,
                  "calibrationDate",
                ),

              calibrationExpiry:
                text(
                  record,
                  "calibrationExpiry",
                ),

              physicallyVerified:
                bool(
                  record,
                  "physicallyVerified",
                ),

              verificationStatus:
                (
                  [
                    "pending",
                    "verified",
                    "rejected",
                    "needs_review",
                  ] as string[]
                ).includes(
                  text(
                    record,
                    "verificationStatus",
                  ),
                )
                  ? (text(
                      record,
                      "verificationStatus",
                    ) as VerificationStatus)
                  : "pending",

              evidenceStatus:
                (
                  [
                    "missing",
                    "uploaded",
                    "verified",
                    "rejected",
                  ] as string[]
                ).includes(
                  text(
                    record,
                    "evidenceStatus",
                  ),
                )
                  ? (text(
                      record,
                      "evidenceStatus",
                    ) as EvidenceStatus)
                  : "missing",

              remarks:
                text(
                  record,
                  "remarks",
                ),
            };
          },
        );
      }

      return [];
    });

  const [selectedMachineId, setSelectedMachineId] =
    useState<string | null>(null);

  const [search, setSearch] =
    useState("");

  const [categoryFilter, setCategoryFilter] =
    useState("all");

  const [statusFilter, setStatusFilter] =
    useState("all");

  const [savedMessage, setSavedMessage] =
    useState("");

  const [showAddMachine, setShowAddMachine] =
    useState(false);

  const [showEvidence, setShowEvidence] =
    useState(false);

  const [evidence, setEvidence] =
    useState<EvidenceRecord[]>([]);

  /* ==========================================================
     SELECTED MACHINE
  ========================================================== */

  const selectedMachine =
    machines.find(
      (machine) =>
        machine.id === selectedMachineId,
    ) ?? null;

  /* ==========================================================
     CATEGORIES
  ========================================================== */

  const categories =
    useMemo(() => {
      const values =
        machines
          .map(
            (machine) =>
              machine.machineCategory,
          )
          .filter(Boolean);

      return Array.from(
        new Set(values),
      );
    }, [machines]);

  /* ==========================================================
     FILTERED MACHINES
  ========================================================== */

  const filteredMachines =
    useMemo(() => {
      const query =
        search
          .trim()
          .toLowerCase();

      return machines.filter(
        (machine) => {
          const matchesSearch =
            !query ||
            machine.machineName
              .toLowerCase()
              .includes(query) ||
            machine.manufacturer
              .toLowerCase()
              .includes(query) ||
            machine.model
              .toLowerCase()
              .includes(query) ||
            machine.serialNumber
              .toLowerCase()
              .includes(query);

          const matchesCategory =
            categoryFilter ===
              "all" ||
            machine.machineCategory ===
              categoryFilter;

          const matchesStatus =
            statusFilter ===
              "all" ||
            machine.machineStatus ===
              statusFilter;

          return (
            matchesSearch &&
            matchesCategory &&
            matchesStatus
          );
        },
      );
    }, [
      machines,
      search,
      categoryFilter,
      statusFilter,
    ]);

  /* ==========================================================
     SUMMARY
  ========================================================== */

  const summary =
    useMemo(() => {
      const total =
        machines.reduce(
          (sum, machine) =>
            sum +
            numberValue(
              machine.quantity,
              0,
            ),
          0,
        );

      const owned =
        machines.filter(
          (machine) =>
            machine.ownership ===
            "owned",
        ).length;

      const leased =
        machines.filter(
          (machine) =>
            machine.ownership ===
            "leased",
        ).length;

      const operational =
        machines.filter(
          (machine) =>
            machine.machineStatus ===
            "operational",
        ).length;

      const verified =
        machines.filter(
          (machine) =>
            machine.physicallyVerified &&
            machine.verificationStatus ===
              "verified",
        ).length;

      const evidenceComplete =
        machines.filter(
          (machine) =>
            machine.evidenceStatus ===
            "verified",
        ).length;

      const calibrationRequired =
        machines.filter(
          (machine) =>
            machine.calibrationRequired,
        ).length;

      return {
        records: machines.length,
        total,
        owned,
        leased,
        operational,
        verified,
        evidenceComplete,
        calibrationRequired,
      };
    }, [machines]);

  /* ==========================================================
     COMPLETION
  ========================================================== */

  const completion =
    useMemo(() => {
      if (
        machines.length === 0
      ) {
        return 0;
      }

      let score = 0;

      for (const machine of machines) {
        if (
          machine.machineName.trim()
        ) {
          score += 1;
        }

        if (
          machine.machineCategory.trim()
        ) {
          score += 1;
        }

        if (
          machine.manufacturer.trim()
        ) {
          score += 1;
        }

        if (
          machine.model.trim()
        ) {
          score += 1;
        }

        if (
          machine.serialNumber.trim()
        ) {
          score += 1;
        }

        if (
          machine.capacity.trim()
        ) {
          score += 1;
        }

        if (
          machine.physicallyVerified
        ) {
          score += 1;
        }

        if (
          machine.evidenceStatus ===
          "verified"
        ) {
          score += 1;
        }
      }

      const possible =
        machines.length * 8;

      return Math.round(
        (score / possible) * 100,
      );
    }, [machines]);

  /* ==========================================================
     READINESS
  ========================================================== */

  const readiness =
    useMemo(() => {
      if (
        machines.length === 0
      ) {
        return 0;
      }

      let score = 0;

      for (const machine of machines) {
        if (
          machine.machineName.trim()
        ) {
          score += 10;
        }

        if (
          machine.machineCategory.trim()
        ) {
          score += 10;
        }

        if (
          machine.manufacturer.trim()
        ) {
          score += 10;
        }

        if (
          machine.model.trim()
        ) {
          score += 10;
        }

        if (
          machine.serialNumber.trim()
        ) {
          score += 10;
        }

        if (
          machine.capacity.trim()
        ) {
          score += 10;
        }

        if (
          machine.physicallyVerified
        ) {
          score += 15;
        }

        if (
          machine.evidenceStatus ===
          "verified"
        ) {
          score += 15;
        }

        if (
          machine.machineStatus ===
          "operational"
        ) {
          score += 10;
        }
      }

      const max =
        machines.length * 100;

      return Math.round(
        (score / max) * 100,
      );
    }, [machines]);

  /* ==========================================================
     RISK
  ========================================================== */

  const risk =
    useMemo(() => {
      if (
        machines.length === 0
      ) {
        return "critical";
      }

      const unverified =
        machines.filter(
          (machine) =>
            !machine.physicallyVerified,
        ).length;

      const missingEvidence =
        machines.filter(
          (machine) =>
            machine.evidenceStatus ===
            "missing",
        ).length;

      const nonOperational =
        machines.filter(
          (machine) =>
            machine.machineStatus ===
              "not_operational" ||
            machine.machineStatus ===
              "under_maintenance",
        ).length;

      const riskPoints =
        unverified * 2 +
        missingEvidence * 2 +
        nonOperational * 1;

      if (
        riskPoints >=
        machines.length * 4
      ) {
        return "critical";
      }

      if (
        riskPoints >=
        machines.length * 2
      ) {
        return "high";
      }

      if (
        riskPoints > 0
      ) {
        return "moderate";
      }

      return "low";
    }, [machines]);

  /* ==========================================================
     ADD MACHINE
  ========================================================== */

  function addMachine() {
    const machine =
      createMachine();

    setMachines(
      (current) => [
        ...current,
        machine,
      ],
    );

    setSelectedMachineId(
      machine.id,
    );

    setShowAddMachine(
      false,
    );

    setSavedMessage("");
  }

  /* ==========================================================
     REMOVE MACHINE
  ========================================================== */

  function removeMachine(
    machineId: string,
  ) {
    setMachines(
      (current) =>
        current.filter(
          (machine) =>
            machine.id !==
            machineId,
        ),
    );

    setEvidence(
      (current) =>
        current.filter(
          (item) =>
            item.machineId !==
            machineId,
        ),
    );

    if (
      selectedMachineId ===
      machineId
    ) {
      setSelectedMachineId(
        null,
      );
    }

    setSavedMessage("");
  }

  /* ==========================================================
     UPDATE MACHINE
  ========================================================== */

  function updateMachine(
    machineId: string,
    patch: Partial<MachineryRecord>,
  ) {
    setMachines(
      (current) =>
        current.map(
          (machine) =>
            machine.id ===
            machineId
              ? {
                  ...machine,
                  ...patch,
                }
              : machine,
        ),
    );

    setSavedMessage("");
  }

  /* ==========================================================
     SAVE
  ========================================================== */

  function saveProgress() {
    /*
     * Persistence hook intentionally kept
     * isolated from this UI layer.
     *
     * The server action / repository can
     * consume this normalized payload in
     * the next integration step.
     */

    const payload = {
      assessmentId,
      machinery: machines,
      evidence,
      summary,
      completion,
      readiness,
      risk,
    };

    try {
      window.localStorage.setItem(
        `gemlotus-machinery-${assessmentId}`,
        JSON.stringify(payload),
      );

      setSavedMessage(
        "Machinery assessment progress saved.",
      );
    } catch {
      setSavedMessage(
        "Unable to save local assessment progress.",
      );
    }
  }

  /* ==========================================================
     ADD EVIDENCE
  ========================================================== */

  function addEvidence(
    machineId: string,
    type: EvidenceRecord["type"],
  ) {
    const item: EvidenceRecord = {
      id: createEvidenceId(),
      machineId,
      type,
      name: "",
      status: "uploaded",
      remarks: "",
    };

    setEvidence(
      (current) => [
        ...current,
        item,
      ],
    );

    updateMachine(
      machineId,
      {
        evidenceStatus:
          "uploaded",
      },
    );
  }

  /* ==========================================================
     UPDATE EVIDENCE
  ========================================================== */

  function updateEvidence(
    evidenceId: string,
    patch: Partial<EvidenceRecord>,
  ) {
    setEvidence(
      (current) =>
        current.map(
          (item) =>
            item.id ===
            evidenceId
              ? {
                  ...item,
                  ...patch,
                }
              : item,
        ),
    );
  }

  /* ==========================================================
     REMOVE EVIDENCE
  ========================================================== */

  function removeEvidence(
    evidenceId: string,
  ) {
    setEvidence(
      (current) =>
        current.filter(
          (item) =>
            item.id !==
            evidenceId,
        ),
    );
  }

  /* ==========================================================
     MAIN UI
  ========================================================== */

  return (
    <main className="min-h-screen bg-[#030914] text-white">
      <div className="flex min-h-screen">

        <AssessmentSidebar
          assessmentId={
            assessmentId
          }
        />

        <div className="min-w-0 flex-1">

          {/* ==================================================
             HEADER
          ================================================== */}

          <header className="border-b border-white/[0.06] px-6 py-7 lg:px-10">

            <div className="flex flex-col gap-6 xl:flex-row xl:items-end xl:justify-between">

              <div>

                <div className="text-[9px] font-bold uppercase tracking-[0.25em] text-cyan-300/60">
                  Step 04 • Factory Assessment
                </div>

                <h1 className="mt-2 text-3xl font-semibold tracking-tight">
                  Machinery Capability Assessment
                </h1>

                <p className="mt-3 max-w-4xl text-sm leading-7 text-blue-100/45">
                  Evidence-first physical
                  verification of manufacturing
                  machinery, ownership,
                  operational capability,
                  capacity, maintenance,
                  calibration and production
                  relevance.
                </p>

              </div>

              <div className="grid grid-cols-2 gap-3 sm:grid-cols-4">

                <Metric
                  label="Machines"
                  value={String(
                    summary.records,
                  )}
                />

                <Metric
                  label="Completion"
                  value={`${completion}%`}
                />

                <Metric
                  label="Readiness"
                  value={`${readiness}%`}
                />

                <Metric
                  label="Risk"
                  value={risk}
                />

              </div>

            </div>

          </header>

          {/* ==================================================
             CONTENT
          ================================================== */}

          <div className="p-6 lg:p-10">

            {/* =================================================
               TOP CONTROL BAR
            ================================================= */}

            <div className="mb-6 rounded-2xl border border-white/[0.07] bg-white/[0.025] p-4">

              <div className="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">

                <div className="flex flex-1 flex-col gap-3 md:flex-row">

                  <input
                    value={search}
                    onChange={(event) =>
                      setSearch(
                        event.target.value,
                      )
                    }
                    placeholder="Search machine, manufacturer, model or serial..."
                    className="min-w-0 flex-1 rounded-xl border border-white/[0.08] bg-black/[0.16] px-4 py-3 text-sm text-white outline-none placeholder:text-white/20 focus:border-cyan-300/30"
                  />

                  <select
                    value={
                      categoryFilter
                    }
                    onChange={(event) =>
                      setCategoryFilter(
                        event.target.value,
                      )
                    }
                    className="rounded-xl border border-white/[0.08] bg-[#071426] px-4 py-3 text-sm text-white outline-none"
                  >

                    <option value="all">
                      All Categories
                    </option>

                    {categories.map(
                      (category) => (
                        <option
                          key={
                            category
                          }
                          value={
                            category
                          }
                        >
                          {category}
                        </option>
                      ),
                    )}

                  </select>

                  <select
                    value={
                      statusFilter
                    }
                    onChange={(event) =>
                      setStatusFilter(
                        event.target.value,
                      )
                    }
                    className="rounded-xl border border-white/[0.08] bg-[#071426] px-4 py-3 text-sm text-white outline-none"
                  >

                    <option value="all">
                      All Status
                    </option>

                    <option value="operational">
                      Operational
                    </option>

                    <option value="partially_operational">
                      Partially Operational
                    </option>

                    <option value="under_maintenance">
                      Under Maintenance
                    </option>

                    <option value="not_operational">
                      Not Operational
                    </option>

                  </select>

                </div>

                <button
                  type="button"
                  onClick={() =>
                    setShowAddMachine(
                      true,
                    )
                  }
                  className="rounded-xl bg-gradient-to-r from-cyan-400 to-blue-500 px-5 py-3 text-[9px] font-bold uppercase tracking-[0.15em] text-[#031020] transition hover:brightness-110"
                >
                  + Add Machinery
                </button>

              </div>

            </div>

            {/* =================================================
               SUMMARY CARDS
            ================================================= */}

            <div className="mb-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-6">

              <SummaryCard
                label="Total Records"
                value={summary.records}
              />

              <SummaryCard
                label="Physical Units"
                value={summary.total}
              />

              <SummaryCard
                label="Owned"
                value={summary.owned}
              />

              <SummaryCard
                label="Leased"
                value={summary.leased}
              />

              <SummaryCard
                label="Physically Verified"
                value={summary.verified}
              />

              <SummaryCard
                label="Evidence Complete"
                value={
                  summary.evidenceComplete
                }
              />

            </div>

            {/* =================================================
               WORKSPACE GRID
            ================================================= */}

            <div className="grid gap-6 xl:grid-cols-[minmax(0,1fr)_460px]">

              {/* ===============================================
                 MACHINE REGISTER
              =============================================== */}

              <section className="rounded-[24px] border border-white/[0.08] bg-white/[0.025]">

                <div className="border-b border-white/[0.06] p-5">

                  <div className="flex items-center justify-between">

                    <div>

                      <div className="text-[8px] font-bold uppercase tracking-[0.2em] text-cyan-300/50">
                        Physical Asset Register
                      </div>

                      <h2 className="mt-2 text-lg font-semibold">
                        Machinery Register
                      </h2>

                    </div>

                    <div className="text-[9px] text-white/30">
                      {
                        filteredMachines.length
                      }{" "}
                      shown
                    </div>

                  </div>

                </div>

                <div className="p-4">

                  {filteredMachines.length ===
                    0 && (
                    <div className="rounded-2xl border border-dashed border-white/[0.08] bg-black/[0.12] p-10 text-center">

                      <div className="text-sm font-semibold text-white/45">
                        No machinery records
                      </div>

                      <p className="mt-2 text-[10px] leading-5 text-white/25">
                        Add each major machine
                        physically available
                        at the manufacturing
                        premises.
                      </p>

                      <button
                        type="button"
                        onClick={() =>
                          setShowAddMachine(
                            true,
                          )
                        }
                        className="mt-5 rounded-xl border border-cyan-300/15 px-5 py-3 text-[9px] font-bold uppercase tracking-wider text-cyan-200"
                      >
                        + Add First Machine
                      </button>

                    </div>
                  )}

                  <div className="space-y-3">

                    {filteredMachines.map(
                      (
                        machine,
                      ) => (
                        <MachineRow
                          key={
                            machine.id
                          }
                          machine={
                            machine
                          }
                          selected={
                            selectedMachineId ===
                            machine.id
                          }
                          onSelect={() =>
                            setSelectedMachineId(
                              machine.id,
                            )
                          }
                          onDelete={() =>
                            removeMachine(
                              machine.id,
                            )
                          }
                        />
                      ),
                    )}

                  </div>

                </div>

              </section>

              {/* ===============================================
                 DETAIL PANEL
              =============================================== */}

              <section className="rounded-[24px] border border-white/[0.08] bg-white/[0.025]">

                {selectedMachine ? (
                  <MachineDetail
                    machine={
                      selectedMachine
                    }
                    evidence={
                      evidence.filter(
                        (item) =>
                          item.machineId ===
                          selectedMachine.id,
                      )
                    }
                    onUpdate={(
                      patch,
                    ) =>
                      updateMachine(
                        selectedMachine.id,
                        patch,
                      )
                    }
                    onAddEvidence={
                      (type) =>
                        addEvidence(
                          selectedMachine.id,
                          type,
                        )
                    }
                    onUpdateEvidence={
                      updateEvidence
                    }
                    onRemoveEvidence={
                      removeEvidence
                    }
                  />
                ) : (
                  <div className="flex min-h-[500px] items-center justify-center p-8 text-center">

                    <div>

                      <div className="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl border border-cyan-300/10 bg-cyan-300/[0.04] text-xl">
                        ⚙
                      </div>

                      <h3 className="mt-5 text-sm font-semibold text-white/55">
                        Select a machinery
                        record
                      </h3>

                      <p className="mt-2 max-w-xs text-[10px] leading-5 text-white/25">
                        Select a machine from
                        the register to inspect
                        its physical capability,
                        evidence and verification
                        status.
                      </p>

                    </div>

                  </div>
                )}

              </section>

            </div>

            {/* =================================================
               BOTTOM ACTION BAR
            ================================================= */}

            <div className="mt-6 flex flex-col gap-4 rounded-2xl border border-white/[0.07] bg-white/[0.025] p-5 lg:flex-row lg:items-center lg:justify-between">

              <div>

                <div className="text-[8px] font-bold uppercase tracking-[0.18em] text-white/25">
                  Assessment Status
                </div>

                <div className="mt-2 flex flex-wrap items-center gap-3">

                  <StatusBadge
                    label={`${completion}% complete`}
                  />

                  <StatusBadge
                    label={`${readiness}% readiness`}
                  />

                  <StatusBadge
                    label={`${risk} risk`}
                  />

                </div>

                {savedMessage && (
                  <div className="mt-3 text-[10px] text-emerald-300/70">
                    {savedMessage}
                  </div>
                )}

              </div>

              <div className="flex flex-wrap gap-3">

                <button
                  type="button"
                  onClick={saveProgress}
                  className="rounded-xl border border-cyan-300/15 bg-cyan-300/[0.05] px-5 py-3 text-[9px] font-bold uppercase tracking-[0.14em] text-cyan-200 transition hover:bg-cyan-300/[0.10]"
                >
                  Save Progress
                </button>

              </div>

            </div>

          </div>

        </div>

      </div>

      {/* ========================================================
         ADD MACHINE MODAL
      ======================================================== */}

      {showAddMachine && (
        <Modal
          title="Add Machinery Record"
          onClose={() =>
            setShowAddMachine(
              false,
            )
          }
        >

          <p className="text-sm leading-6 text-white/40">
            Add one physical machinery
            record at a time. Every machine
            should subsequently be supported
            by documentary and physical
            verification evidence.
          </p>

          <div className="mt-6 grid gap-3 sm:grid-cols-2">

            <button
              type="button"
              onClick={addMachine}
              className="rounded-xl border border-cyan-300/15 bg-cyan-300/[0.05] p-5 text-left transition hover:bg-cyan-300/[0.09]"
            >

              <div className="text-sm font-semibold text-cyan-100">
                Add Physical Machine
              </div>

              <div className="mt-2 text-[10px] leading-5 text-white/30">
                Create a new machine
                register entry.
              </div>

            </button>

            <button
              type="button"
              onClick={() =>
                setShowAddMachine(
                  false,
                )
              }
              className="rounded-xl border border-white/[0.07] p-5 text-left transition hover:bg-white/[0.04]"
            >

              <div className="text-sm font-semibold text-white/55">
                Cancel
              </div>

              <div className="mt-2 text-[10px] leading-5 text-white/30">
                Return to machinery
                register.
              </div>

            </button>

          </div>

        </Modal>
      )}

    </main>
  );
}

