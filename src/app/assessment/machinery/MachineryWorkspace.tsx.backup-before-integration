/* ============================================================
 AUTOMATIC FINDINGS
============================================================ */

function MachineryAudit7GenerateFindings(
records: MachineryRecord[],
): MachineryAudit7Finding[] {
const findings: MachineryAudit7Finding[] =
  [];

if (
  records.length ===
  0
) {
  findings.push({
    id:
      "machinery-audit-7-no-record",
    title:
      "No machinery records available",
    description:
      "No machinery has been registered for the assessment.",
    severity:
      "critical",
    status:
      "open",
    recommendation:
      "Enter all machinery physically available at the manufacturing facility.",
  });

  return findings;
}


records.forEach(
  (record, index) => {
    const name =
      MachineryAudit7MachineName(
        record,
        index,
      );

    const physical =
      MachineryAudit7Physical(
        record,
      );

    const operational =
      MachineryAudit7Operational(
        record,
      );

    const maintenance =
      MachineryAudit7Maintenance(
        record,
      );

    const verification =
      MachineryAudit7Verification(
        record,
      );


    if (
      !physical
    ) {
      findings.push({
        id:
          `machinery-audit-7-physical-${index}`,
        title:
          `${name}: Physical verification pending`,
        description:
          "Physical existence of the declared machinery has not been confirmed.",
        severity:
          "major",
        status:
          "open",
        recommendation:
          "Physically inspect the machinery and record the verification result.",
        machineryIndex:
          index,
      });
    }


    if (
      !operational
    ) {
      findings.push({
        id:
          `machinery-audit-7-operational-${index}`,
        title:
          `${name}: Operational verification pending`,
        description:
          "The machine has not been confirmed operational during the assessment.",
        severity:
          "minor",
        status:
          "open",
        recommendation:
          "Observe operation where practicable and document the observed condition.",
        machineryIndex:
          index,
      });
    }


    if (
      !maintenance
    ) {
      findings.push({
        id:
          `machinery-audit-7-maintenance-${index}`,
        title:
          `${name}: Maintenance evidence incomplete`,
        description:
          "Clear maintenance evidence has not been identified.",
        severity:
          "minor",
        status:
          "open",
        recommendation:
          "Provide maintenance records, preventive maintenance schedule or service evidence.",
        machineryIndex:
          index,
      });
    }


    if (
      verification ===
      "rejected"
    ) {
      findings.push({
        id:
          `machinery-audit-7-rejected-${index}`,
        title:
          `${name}: Verification rejected`,
        description:
          "The machinery verification status indicates rejection.",
        severity:
          "critical",
        status:
          "open",
        recommendation:
          "Review the rejection reason and obtain acceptable supporting evidence.",
        machineryIndex:
          index,
      });
    }


    if (
      verification ===
      "needs_review"
    ) {
      findings.push({
        id:
          `machinery-audit-7-review-${index}`,
        title:
          `${name}: Additional review required`,
        description:
          "The machinery record requires additional verification or assessor review.",
        severity:
          "major",
        status:
          "open",
        recommendation:
          "Complete the outstanding verification and supporting evidence review.",
        machineryIndex:
          index,
      });
    }
  },
);


return findings;
}


/* ============================================================
 SAFE MACHINERY FIELD READERS
 ------------------------------------------------------------
 IMPORTANT:
 These functions access only known fields.
 No record[string] indexing.
============================================================ */

function MachineryAudit7MachineName(
record: MachineryRecord,
index: number,
): string {
if (
  "name" in record &&
  typeof record.name ===
    "string" &&
  record.name.trim()
) {
  return record.name;
}

if (
  "machineName" in record &&
  typeof record.machineName ===
    "string" &&
  record.machineName.trim()
) {
  return record.machineName;
}

return `Machinery #${
  index + 1
}`;
}


function MachineryAudit7Physical(
record: MachineryRecord,
): boolean {
return (
  "physicalVerification" in
    record &&
  record.physicalVerification ===
    true
);
}


function MachineryAudit7Operational(
record: MachineryRecord,
): boolean {
return (
  "operationalDuringVisit" in
    record &&
  record.operationalDuringVisit ===
    true
);
}


function MachineryAudit7Maintenance(
record: MachineryRecord,
): boolean {
const maintenance =
  "maintenanceAvailable" in
    record &&
  record.maintenanceAvailable ===
    true;

const maintenanceRecord =
  "maintenanceRecordAvailable" in
    record &&
  record.maintenanceRecordAvailable ===
    true;

return (
  maintenance ||
  maintenanceRecord
);
}


function MachineryAudit7Verification(
record: MachineryRecord,
): string {
if (
  "verificationStatus" in
    record &&
  typeof record.verificationStatus ===
    "string"
) {
  return record.verificationStatus;
}

return "pending";
}


/* ============================================================
 INITIAL DISPOSITION
============================================================ */

function MachineryAudit7InitialDisposition(
summary: MachineryAssessmentSummaryData,
): MachineryAudit7Disposition {
if (
  summary.totalMachinery ===
  0
) {
  return "not_ready";
}

if (
  summary.overallScore >=
  75
) {
  return "ready";
}

if (
  summary.overallScore >=
  60
) {
  return "conditionally_ready";
}

if (
  summary.overallScore >=
  40
) {
  return "needs_improvement";
}

return "not_ready";
}


