        </div>
  
      </div>
    );
  }
  
  
  /* ============================================================
     MACHINE OVERALL STATUS
  ============================================================ */
  
  function getMachineOverallStatus(
    record: MachineryRecord,
  ): string {
    const verification =
      getString(
        record,
        "verificationStatus",
      );
  
    if (
      verification ===
      "rejected"
    ) {
      return "high_risk";
    }
  
    if (
      verification ===
      "needs_review"
    ) {
      return "review";
    }
  
    const physical =
      getBoolean(
        record,
        "physicalVerification",
      );
  
    const operational =
      getBoolean(
        record,
        "operationalDuringVisit",
      );
  
    const maintenance =
      getBoolean(
        record,
        "maintenanceAvailable",
      ) ||
      getBoolean(
        record,
        "maintenanceRecordAvailable",
      );
  
    if (
      physical &&
      operational &&
      maintenance
    ) {
      return "ready";
    }
  
    if (
      physical &&
      (operational ||
        maintenance)
    ) {
      return "conditional";
    }
  
    return "incomplete";
  }
  
  
  /* ============================================================
     MACHINE STATUS BADGE
  ============================================================ */
  
  function MachineStatusBadge({
    status,
  }: {
    status: string;
  }) {
    let className =
      "border-white/[0.08] bg-white/[0.03] text-white/30";
  
    if (
      status ===
      "ready"
    ) {
      className =
        "border-emerald-300/10 bg-emerald-300/[0.04] text-emerald-200";
    }
  
    if (
      status ===
      "conditional"
    ) {
      className =
        "border-amber-300/10 bg-amber-300/[0.04] text-amber-200";
    }
  
    if (
      status ===
      "high_risk"
    ) {
      className =
        "border-red-300/10 bg-red-300/[0.04] text-red-200";
    }
  
    if (
      status ===
      "review"
    ) {
      className =
        "border-blue-300/10 bg-blue-300/[0.04] text-blue-200";
    }
  
    return (
      <span
        className={`inline-flex rounded-md border px-2 py-1 text-[6px] font-bold uppercase tracking-[0.1em] ${className}`}
      >
        {formatLabel(
          status,
        )}
      </span>
    );
  }
  
  
