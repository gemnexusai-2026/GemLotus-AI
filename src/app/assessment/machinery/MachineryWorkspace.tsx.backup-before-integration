        "Physical existence and verification of declared machinery.",
      weight:
        20,
      score:
        physicalScore,
      status:
        MachineryScore10DimensionStatus(
          physicalScore,
        ),
    },

    {
      code:
        "operational",
      name:
        "Operational Capability",
      description:
        "Observed or recorded operational capability of machinery.",
      weight:
        20,
      score:
        operationalScore,
      status:
        MachineryScore10DimensionStatus(
          operationalScore,
        ),
    },

    {
      code:
        "capability",
      name:
        "Machinery Capability",
      description:
        "Overall declared machinery capability and supporting operational indicators.",
      weight:
        20,
      score:
        capability,
      status:
        MachineryScore10DimensionStatus(
