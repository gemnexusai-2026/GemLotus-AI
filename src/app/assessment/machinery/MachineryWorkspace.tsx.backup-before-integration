  ============================================================ */
  
  function getString(
    record: MachineryRecord,
    key: string,
  ): string {
    const value =
      (record as unknown as Record<
        string,
        unknown
      >)[key];
  
    if (
      value === null ||
      value === undefined
    ) {
      return "";
    }
  
    return String(value);
  }
  
  
  function getBoolean(
    record: MachineryRecord,
    key: string,
  ): boolean {
    const value =
      (record as unknown as Record<
        string,
        unknown
      >)[key];
  
    return Boolean(value);
  }
  
  
  function setFlexibleField(
    onUpdate: (
      patch: Partial<MachineryRecord>,
    ) => void,
    key: string,
    value: unknown,
  ) {
    onUpdate({
      [key]: value,
    } as Partial<MachineryRecord>);
  }
  
  
  function formatLabel(
    value: string,
  ): string {
    return value
      .replaceAll("_", " ")
      .replace(/\b\w/g, (character) =>
        character.toUpperCase(),
      );
  }
  
  
  function getRecordKey(
    record: MachineryRecord,
    index: number,
  ): string {
    const possibleId =
      getString(record, "id");
  
    return (
      possibleId ||
      `machinery-${index}`
    );
  }
  
  
  function getMachineryDisplayName(
    record: MachineryRecord,
    index: number,
  ): string {
    const machineName =
      getString(
        record,
        "machineName",
      );
  
    if (machineName) {
      return machineName;
    }
  
    const equipmentName =
      getString(
        record,
        "equipmentName",
      );
  
    if (equipmentName) {
      return equipmentName;
    }
  
    const machineType =
      getString(
        record,
        "machineType",
      );
  
    if (machineType) {
      return machineType;
    }
  
    return `Machinery #${index + 1}`;
  }
  
  
  /* ============================================================
     EMPTY RECORD
  ============================================================ */
  
  function createEmptyMachineryRecord(): MachineryRecord {
    return {
      /*
       * Keep the initial object deliberately minimal.
       * Existing optional fields can be filled through
       * the workspace without inventing a new schema.
       */
      ownership:
        "owned",
      verificationStatus:
        "pending",
      maintenanceAvailable:
        false,
    } as MachineryRecord;
  }

