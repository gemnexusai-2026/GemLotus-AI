      finding.status !==
        "resolved" &&
      finding.status !==
        "accepted",
  );

const criticalFindings =
  findings.filter(
    (finding) =>
      finding.severity ===
        "critical" &&
      finding.status !==
        "resolved" &&
      finding.status !==
        "accepted",
  );

