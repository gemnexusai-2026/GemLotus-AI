/* ============================================================
   INTERNAL EVIDENCE TYPE
============================================================ */

type MachineryScore10EvidenceItem = {
  verification:
    | "pending"
    | "accepted"
    | "rejected"
    | "needs_review";
};


/* ============================================================
   CALCULATION ENGINE
============================================================ */

function MachineryScore10Calculate(
  records: MachineryRecord[],
  evidenceRecords: MachineryScore10EvidenceItem[],
  findings: MachineryScore10Finding[],
): MachineryScore10Result {
  const capabilityScore =
    MachineryScore10Capability(
      records,
    );


  const evidenceScore =
    MachineryScore10Evidence(
      evidenceRecords,
    );


  const verificationScore =
    MachineryScore10Verification(
      evidenceRecords,
    );


  const findingScore =
    MachineryScore10FindingScore(
      findings,
    );


  const dimensions =
    MachineryScore10Dimensions(
      records,
      evidenceRecords,
      findings,
    );


  const weightedDimensionScore =
    dimensions.reduce(
      (
        total,
        dimension,
      ) =>
        total +
        (dimension.score *
          dimension.weight) /
          100,
      0,
    );


  const finalScore =
    Math.round(
      weightedDimensionScore,
    );


  const openFindings =
    findings.filter(
      (finding) =>
        finding.status ===
          "open" ||
        finding.status ===
          "in_progress",
    ).length;


  const criticalFindings =
    findings.filter(
      (finding) =>
        finding.severity ===
          "critical" &&
        finding.status !==
          "resolved" &&
        finding.status !==
          "accepted",
    ).length;


  const risk =
    MachineryScore10Risk(
      finalScore,
      criticalFindings,
      findings,
      evidenceRecords,
    );


  const readiness =
    MachineryScore10Readiness(
      finalScore,
      criticalFindings,
      evidenceRecords,
    );


  const recommendation =
    MachineryScore10Recommendation(
      readiness,
      risk,
      finalScore,
      evidenceRecords,
      criticalFindings,
    );


  return {
    capabilityScore,
    evidenceScore,
    verificationScore,
    findingScore,
    finalScore,
    risk,
    readiness,
    dimensions,
    openFindings,
    criticalFindings,
    recommendation,
  };
}


/* ============================================================
   CAPABILITY SCORE
============================================================ */

function MachineryScore10Capability(
  records: MachineryRecord[],
): number {
  if (
    records.length ===
    0
  ) {
    return 0;
  }


  let total =
    0;


  records.forEach(
    (record) => {
      let score =
        0;


      const physical =
        "physicalVerification" in
          record &&
        record.physicalVerification ===
          true;

      const operational =
        "operationalDuringVisit" in
          record &&
        record.operationalDuringVisit ===
          true;

      const maintenance =
        ("maintenanceAvailable" in
          record &&
          record.maintenanceAvailable ===
            true) ||
        ("maintenanceRecordAvailable" in
          record &&
          record.maintenanceRecordAvailable ===
            true);

      const quantity =
        "quantity" in
          record &&
        typeof record.quantity ===
          "number" &&
        record.quantity >
          0;


      if (
        physical
      ) {
        score +=
          30;
      }

      if (
        operational
      ) {
        score +=
          30;
      }

      if (
        maintenance
      ) {
        score +=
          20;
      }

      if (
        quantity
      ) {
        score +=
          20;
      }


      total +=
        score;
    },
  );


  return Math.round(
    total /
      records.length,
  );
}


/* ============================================================
   EVIDENCE SCORE
============================================================ */

function MachineryScore10Evidence(
  evidenceRecords: MachineryScore10EvidenceItem[],
): number {
  if (
    evidenceRecords.length ===
    0
  ) {
    return 0;
  }


  let total =
    0;


  evidenceRecords.forEach(
    (item) => {
      if (
        item.verification ===
        "accepted"
      ) {
        total +=
          100;
        return;
      }

      if (
        item.verification ===
        "needs_review"
      ) {
        total +=
          50;
        return;
      }

      if (
        item.verification ===
        "pending"
      ) {
        total +=
          25;
        return;
      }

      total +=
        0;
    },
  );


  return Math.round(
    total /
      evidenceRecords.length,
  );
}


/* ============================================================
   VERIFICATION SCORE
============================================================ */

function MachineryScore10Verification(
  evidenceRecords: MachineryScore10EvidenceItem[],
): number {
  if (
    evidenceRecords.length ===
    0
  ) {
    return 0;
  }


  const accepted =
    evidenceRecords.filter(
      (item) =>
        item.verification ===
        "accepted",
    ).length;


  return Math.round(
    (accepted /
      evidenceRecords.length) *
      100,
  );
}


/* ============================================================
   FINDING SCORE
============================================================ */

function MachineryScore10FindingScore(
  findings: MachineryScore10Finding[],
): number {
  if (
    findings.length ===
    0
  ) {
    return 100;
  }


  let penalty =
    0;


  findings.forEach(
    (finding) => {
      if (
        finding.status ===
          "resolved" ||
        finding.status ===
          "accepted"
      ) {
        return;
      }


      if (
        finding.severity ===
        "observation"
      ) {
        penalty +=
          2;
      }

      if (
        finding.severity ===
        "minor"
      ) {
        penalty +=
          5;
      }

      if (
        finding.severity ===
        "major"
      ) {
        penalty +=
          12;
      }

      if (
        finding.severity ===
        "critical"
      ) {
        penalty +=
          30;
      }
    },
  );


  return Math.max(
    0,
    100 -
      penalty,
  );
}


/* ============================================================
   DIMENSIONS
============================================================ */

