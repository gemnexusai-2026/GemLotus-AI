                    updateEvidence(
                      item.id,
                      patch,
                    )
                  }
                />
              ),
            )}

          </div>
        )}

      </div>


      {/* ======================================================
         GAP SUMMARY
      ====================================================== */}

      <MachineryEvidence8GapSummary
        items={
          evidenceItems
        }

      />

    </div>
  );
}


/* ============================================================
   BUILD MATRIX
============================================================ */

function MachineryEvidence8BuildMatrix(
  records: MachineryRecord[],
): MachineryEvidence8Item[] {
  const items: MachineryEvidence8Item[] =
    [];


  records.forEach(
    (
      record,
      machineIndex,
    ) => {
      const machineName =
        MachineryEvidence8MachineName(
          record,
          machineIndex,
        );


      const definitions =
        MachineryEvidence8Definitions();


      definitions.forEach(
        (
          definition,
        ) => {
          const available =
            MachineryEvidence8EvidenceAvailable(
              record,
              definition.category,
            );

          const verification =
            MachineryEvidence8VerificationStatus(
              record,
            );


          let status:
            MachineryEvidence8Status =
            available
              ? "available"
              : "missing";


          if (
            verification ===
              "needs_review" &&
            available
          ) {
            status =
              "pending_review";
          }


          if (
            verification ===
              "rejected"
          ) {
            status =
              "rejected";
          }


          items.push({
            id:
              `machinery-evidence-8-${machineIndex}-${definition.category}`,

            category:
              definition.category,

            title:
              `${machineName} — ${definition.title}`,

            description:
              definition.description,

            required:
              definition.required,

            status,

            priority:
              definition.required
                ? "high"
                : "low",

            remarks:
              "",

            correctiveAction:
              available
                ? ""
                : definition.correctiveAction,

            machineryIndex:
              machineIndex,
          });
        },
      );
    },
  );


  return items;
}


