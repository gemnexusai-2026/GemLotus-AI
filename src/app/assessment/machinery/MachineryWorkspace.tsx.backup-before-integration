function MachineryRegisterSection({
    records,
    updateRecords,
  }: {
    records: MachineryRecord[];
    updateRecords: (
      records: MachineryRecord[],
    ) => void;
  }) {
    function addRecord() {
      const record = createEmptyMachineryRecord();
      updateRecords([...records, record]);
    }
  
    function removeRecord(index: number) {
      updateRecords(
        records.filter(
          (_, currentIndex) =>
            currentIndex !== index,
        ),
      );
    }
  
    function updateRecord(
      index: number,
      patch: Partial<MachineryRecord>,
    ) {
      const next = [...records];
  
      next[index] = {
        ...next[index],
        ...patch,
      };
  
      updateRecords(next);
    }
  
    return (
      <div className="space-y-6">
  
        <div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  
          <div>
