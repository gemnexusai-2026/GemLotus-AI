            className="w-full rounded-xl border border-white/[0.08] bg-[#071426] px-4 py-3 text-[10px] text-white outline-none focus:border-cyan-300/25"
          >

            <option value="">
              General Evidence
            </option>

            {records.map(
              (
                record,
                index,
              ) => (
                <option
                  key={
                    `evidence9-related-${index}`
