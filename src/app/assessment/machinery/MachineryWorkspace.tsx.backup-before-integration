/* ============================================================
 FILE SIZE FORMATTER
============================================================ */

function formatFileSize(
bytes: number,
): string {
if (
  !bytes ||
  bytes <= 0
) {
  return "0 KB";
}

if (
  bytes <
  1024 * 1024
) {
  return `${Math.max(
    1,
    Math.round(
      bytes / 1024,
    ),
  )} KB`;
}

return `${(
  bytes /
  (1024 * 1024)
).toFixed(1)} MB`;
}
