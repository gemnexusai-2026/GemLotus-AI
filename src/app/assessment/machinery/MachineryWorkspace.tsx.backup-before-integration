/* ============================================================
   PART 8 — MACHINERY EVIDENCE GAP MATRIX
   ------------------------------------------------------------
   Purpose:
   - Evidence requirement matrix
   - Required / optional classification
   - Availability status
   - Verification status
   - Evidence gap identification
   - Corrective action tracking
   - Audit-ready evidence summary
   - No database/schema assumptions
============================================================ */


/* ============================================================
   TYPES
============================================================ */

type MachineryEvidence8Status =
  | "available"
  | "missing"
  | "pending_review"
  | "rejected";

type MachineryEvidence8Priority =
  | "low"
  | "medium"
  | "high"
  | "critical";

type MachineryEvidence8Item = {
  id: string;
  category: string;
  title: string;
  description: string;
  required: boolean;
  status: MachineryEvidence8Status;
  priority: MachineryEvidence8Priority;
  remarks: string;
  correctiveAction: string;
  machineryIndex?: number;
};


/* ============================================================
   EVIDENCE GAP MATRIX
============================================================ */

function MachineryEvidence8GapMatrix({
  records,
}: {
  records: MachineryRecord[];
}) {
  const [
    evidenceItems,
    setEvidenceItems,
  ] = useState<
    MachineryEvidence8Item[]
  >(
    () =>
      MachineryEvidence8BuildMatrix(
        records,
      ),
  );

  const [
    selectedMachine,
    setSelectedMachine,
  ] = useState<
    number | "all"
  >("all");

  const [
    showOnlyGaps,
    setShowOnlyGaps,
  ] = useState(false);


  function updateEvidence(
    id: string,
    patch: Partial<MachineryEvidence8Item>,
  ) {
    setEvidenceItems(
      (current) =>
        current.map(
          (item) =>
            item.id === id
              ? {
                  ...item,
                  ...patch,
                }
              : item,
        ),
    );
  }


  const filtered =
    evidenceItems.filter(
      (item) => {
        if (
          selectedMachine !==
          "all" &&
          item.machineryIndex !==
            selectedMachine
        ) {
          return false;
        }

        if (
          showOnlyGaps &&
          item.status ===
            "available"
        ) {
          return false;
        }

        return true;
      },
    );


  const total =
    filtered.length;

  const available =
    filtered.filter(
      (item) =>
        item.status ===
        "available",
    ).length;

  const missing =
    filtered.filter(
      (item) =>
        item.status ===
        "missing",
    ).length;

  const pending =
    filtered.filter(
      (item) =>
        item.status ===
        "pending_review",
    ).length;

  const rejected =
    filtered.filter(
      (item) =>
        item.status ===
        "rejected",
    ).length;

  const coverage =
    total === 0
      ? 0
