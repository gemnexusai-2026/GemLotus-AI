/* ============================================================
   LABEL FORMATTER
============================================================ */

function MachineryGate12Label(
  value: string,
): string {
  return value
    .replace(
      /_/g,
      " ",
    )
    .replace(
      /\b\w/g,
      (
        character,
      ) =>
        character.toUpperCase(),
    );
}

/* ============================================================
   PART 13 — EVIDENCE & VERIFICATION TRACEABILITY
   ------------------------------------------------------------
   Purpose:
   - Machinery-to-evidence linkage
   - Physical verification traceability
   - Operational verification traceability
   - Document / photo / video reference
   - Evidence status
   - Verification date
   - Verified by
   - Observation
   - Non-conformity reference
   - Audit trail summary
   - Evidence coverage calculation
   - Traceability gaps
============================================================ */


/* ============================================================
   TYPES
============================================================ */

type MachineryTrace13EvidenceType =
  | "document"
  | "photo"
  | "video"
  | "certificate"
  | "test_report"
  | "other";

type MachineryTrace13Status =
  | "pending"
  | "submitted"
  | "verified"
  | "rejected"
  | "not_applicable";

type MachineryTrace13VerificationType =
  | "physical"
  | "operational"
  | "documentary"
  | "identity"
  | "capacity"
  | "maintenance";

type MachineryTrace13Evidence = {
  id: string;
  machineryIndex: number;
  title: string;
  type: MachineryTrace13EvidenceType;
  reference: string;
  status: MachineryTrace13Status;
  uploadedBy: string;
  uploadedAt: string;
  verifiedBy: string;
  verifiedAt: string;
  verificationType: MachineryTrace13VerificationType;
  observation: string;
  findingReference: string;
};

type MachineryTrace13Verification = {
  id: string;
  machineryIndex: number;
  type: MachineryTrace13VerificationType;
  status: MachineryTrace13Status;
  verifiedBy: string;
  verifiedAt: string;
  observation: string;
  evidenceIds: string[];
};

type MachineryTrace13Result = {
  totalMachinery: number;
  machineryWithEvidence: number;
  machineryWithVerification: number;
  evidenceCoverage: number;
  verificationCoverage: number;
  traceabilityCoverage: number;
  gaps: string[];
};


/* ============================================================
   MAIN TRACEABILITY WORKSPACE
============================================================ */

function MachineryTraceability13Workspace({
  records,
}: {
  records: MachineryRecord[];
}) {
  const [
    evidence,
    setEvidence,
  ] = useState<
    MachineryTrace13Evidence[]
  >([]);

  const [
    verifications,
    setVerifications,
  ] = useState<
    MachineryTrace13Verification[]
  >([]);


  const [
    selectedMachinery,
    setSelectedMachinery,
  ] = useState(0);


  const [
    showEvidenceForm,
    setShowEvidenceForm,
  ] = useState(false);


  const [
    showVerificationForm,
    setShowVerificationForm,
  ] = useState(false);


  const [
    evidenceTitle,
    setEvidenceTitle,
  ] = useState("");


  const [
    evidenceType,
    setEvidenceType,
  ] =
    useState<MachineryTrace13EvidenceType>(
      "photo",
    );


  const [
    evidenceReference,
    setEvidenceReference,
  ] = useState("");


  const [
    evidenceStatus,
    setEvidenceStatus,
  ] =
    useState<MachineryTrace13Status>(
      "submitted",
    );


  const [
    evidenceUploadedBy,
    setEvidenceUploadedBy,
  ] = useState("");


  const [
    evidenceUploadedAt,
    setEvidenceUploadedAt,
  ] = useState("");


  const [
    evidenceVerifiedBy,
    setEvidenceVerifiedBy,
  ] = useState("");


  const [
    evidenceVerifiedAt,
    setEvidenceVerifiedAt,
  ] = useState("");


  const [
    evidenceVerificationType,
    setEvidenceVerificationType,
  ] =
    useState<MachineryTrace13VerificationType>(
      "physical",
    );


  const [
    evidenceObservation,
    setEvidenceObservation,
  ] = useState("");


  const [
    evidenceFindingReference,
    setEvidenceFindingReference,
  ] = useState("");


  const [
    verificationType,
    setVerificationType,
  ] =
    useState<MachineryTrace13VerificationType>(
      "physical",
    );


  const [
    verificationStatus,
    setVerificationStatus,
  ] =
    useState<MachineryTrace13Status>(
      "verified",
    );


  const [
    verificationBy,
    setVerificationBy,
  ] = useState("");


  const [
    verificationDate,
    setVerificationDate,
  ] = useState("");


  const [
    verificationObservation,
    setVerificationObservation,
  ] = useState("");


  const result =
    MachineryTrace13Calculate(
      records,
      evidence,
      verifications,
    );


  const selectedRecord =
    records[
      selectedMachinery
    ];


  function resetEvidenceForm() {
    setEvidenceTitle("");
    setEvidenceReference("");
    setEvidenceUploadedBy("");
    setEvidenceUploadedAt("");
    setEvidenceVerifiedBy("");
    setEvidenceVerifiedAt("");
    setEvidenceObservation("");
    setEvidenceFindingReference("");
    setEvidenceStatus("submitted");
    setEvidenceType("photo");
    setEvidenceVerificationType("physical");
  }


  function resetVerificationForm() {
    setVerificationBy("");
    setVerificationDate("");
    setVerificationObservation("");
    setVerificationStatus("verified");
    setVerificationType("physical");
  }


  function addEvidence() {
    if (
      evidenceTitle.trim()
        .length === 0
    ) {
      return;
    }


    const newEvidence: MachineryTrace13Evidence =
      {
        id:
          `M13-E-${Date.now()}-${Math.random()
            .toString(36)
            .slice(2, 8)}`,

        machineryIndex:
          selectedMachinery,

        title:
          evidenceTitle.trim(),

        type:
          evidenceType,

        reference:
          evidenceReference.trim(),

        status:
          evidenceStatus,

        uploadedBy:
          evidenceUploadedBy.trim(),

        uploadedAt:
          evidenceUploadedAt,

        verifiedBy:
          evidenceVerifiedBy.trim(),

        verifiedAt:
          evidenceVerifiedAt,

        verificationType:
          evidenceVerificationType,

        observation:
          evidenceObservation.trim(),

        findingReference:
          evidenceFindingReference.trim(),
      };


    setEvidence(
      (current) => [
        ...current,
        newEvidence,
      ],
    );


    resetEvidenceForm();

    setShowEvidenceForm(
      false,
    );
  }


  function addVerification() {
    const newVerification: MachineryTrace13Verification =
      {
        id:
          `M13-V-${Date.now()}-${Math.random()
            .toString(36)
            .slice(2, 8)}`,

        machineryIndex:
          selectedMachinery,

        type:
          verificationType,

        status:
          verificationStatus,

        verifiedBy:
          verificationBy.trim(),

        verifiedAt:
          verificationDate,

        observation:
          verificationObservation.trim(),

        evidenceIds:
          evidence
            .filter(
              (item) =>
                item.machineryIndex ===
                selectedMachinery,
            )
            .map(
              (item) =>
                item.id,
            ),
      };


    setVerifications(
      (current) => [
        ...current,
        newVerification,
      ],
    );


    resetVerificationForm();

    setShowVerificationForm(
      false,
    );
  }


  function removeEvidence(
    evidenceId: string,
  ) {
    setEvidence(
      (current) =>
        current.filter(
          (item) =>
            item.id !==
            evidenceId,
        ),
    );


    setVerifications(
      (current) =>
        current.map(
          (
            verification,
          ) => ({
            ...verification,
            evidenceIds:
              verification.evidenceIds.filter(
                (id) =>
                  id !==
                  evidenceId,
              ),
          }),
        ),
    );
  }


  function removeVerification(
    verificationId: string,
  ) {
    setVerifications(
      (current) =>
        current.filter(
          (item) =>
            item.id !==
            verificationId,
        ),
    );
  }


  return (
    <div className="space-y-6">

      {/* ======================================================
         HEADER
      ====================================================== */}

      <div className="rounded-2xl border border-cyan-300/10 bg-cyan-300/[0.025] p-6">

        <div className="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">

          <div>

            <div className="text-[8px] font-bold uppercase tracking-[0.22em] text-cyan-300/50">
              Step 13 • Traceability
            </div>

            <h3 className="mt-2 text-xl font-semibold text-white">
              Evidence & Verification Traceability
            </h3>

            <p className="mt-2 max-w-3xl text-[10px] leading-6 text-white/30">
              Every machinery record should be
              traceable to supporting evidence,
              verification activity and assessor
              observations.
            </p>

          </div>


          <div className="rounded-xl border border-cyan-300/10 bg-cyan-300/[0.035] px-4 py-3 text-right">

            <div className="text-[7px] font-bold uppercase tracking-[0.14em] text-white/20">
              Traceability
            </div>

            <div className="mt-1 text-2xl font-semibold text-cyan-200">
              {result.traceabilityCoverage}%
            </div>

          </div>

        </div>

      </div>


      {/* ======================================================
         COVERAGE METRICS
      ====================================================== */}

      <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">

        <MachineryTrace13Metric
          label="Machinery"
          value={
            String(
              result.totalMachinery,
            )
          }
        />

        <MachineryTrace13Metric
          label="With Evidence"
          value={
            `${result.machineryWithEvidence}/${result.totalMachinery}`
          }
        />

        <MachineryTrace13Metric
          label="With Verification"
          value={
            `${result.machineryWithVerification}/${result.totalMachinery}`
          }
        />

        <MachineryTrace13Metric
          label="Evidence Coverage"
          value={
            `${result.evidenceCoverage}%`
          }
        />

      </div>


      {/* ======================================================
         MACHINERY SELECTOR
      ====================================================== */}

      <div className="rounded-2xl border border-white/[0.07] bg-black/[0.13] p-5">

        <div>

          <div className="text-[8px] font-bold uppercase tracking-[0.18em] text-white/30">
            Machinery Selection
          </div>

          <p className="mt-1 text-[8px] leading-5 text-white/20">
            Select a machinery record to manage its
            evidence and verification trail.
          </p>

        </div>


        {records.length ===
        0 ? (
          <div className="mt-5 rounded-xl border border-red-300/10 bg-red-300/[0.025] p-5 text-[9px] text-red-200/60">
            No machinery records are available.
            Complete the machinery register first.
          </div>
        ) : (
          <div className="mt-5 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">

            {records.map(
              (
                record,
                index,
              ) => {

                const machineEvidence =
                  evidence.filter(
                    (item) =>
                      item.machineryIndex ===
                      index,
                  ).length;


                const machineVerification =
                  verifications.filter(
                    (item) =>
                      item.machineryIndex ===
                      index,
                  ).length;


                const active =
                  selectedMachinery ===
                  index;


                return (
                  <button
                    key={
                      `machine-${index}`
                    }
                    type="button"
                    onClick={() =>
                      setSelectedMachinery(
                        index,
                      )
                    }
                    className={`rounded-xl border p-4 text-left transition ${
                      active
                        ? "border-cyan-300/20 bg-cyan-300/[0.06]"
                        : "border-white/[0.06] bg-black/[0.10] hover:bg-white/[0.025]"
                    }`}
                  >

                    <div className="flex items-start justify-between gap-3">

                      <div>

                        <div className="text-[7px] font-bold uppercase tracking-[0.13em] text-white/20">
                          Machinery #
                          {index +
                            1}
                        </div>

                        <div className="mt-1 text-[10px] font-semibold text-white/60">
                          {MachineryTrace13MachineName(
                            record,
                          )}
                        </div>

                      </div>


                      <span className="rounded-md border border-white/[0.06] px-2 py-1 text-[6px] text-white/25">
                        {active
                          ? "Selected"
                          : "Open"}
                      </span>

                    </div>


                    <div className="mt-4 flex gap-2">

                      <span className="rounded-md border border-cyan-300/10 bg-cyan-300/[0.025] px-2 py-1 text-[6px] text-cyan-200/60">
                        Evidence{" "}
                        {
                          machineEvidence
                        }
                      </span>

                      <span className="rounded-md border border-emerald-300/10 bg-emerald-300/[0.025] px-2 py-1 text-[6px] text-emerald-200/60">
                        Verification{" "}
                        {
                          machineVerification
                        }
                      </span>

                    </div>

                  </button>
                );
              },
            )}

          </div>
        )}

      </div>


      {/* ======================================================
         SELECTED MACHINE
      ====================================================== */}

      {selectedRecord && (
        <div className="rounded-2xl border border-cyan-300/10 bg-cyan-300/[0.02] p-5">

          <div className="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">

            <div>

              <div className="text-[7px] font-bold uppercase tracking-[0.15em] text-cyan-300/45">
                Selected Machinery
              </div>

              <h4 className="mt-1 text-lg font-semibold text-white/75">
                {MachineryTrace13MachineName(
                  selectedRecord,
                )}
              </h4>

            </div>


            <div className="flex flex-wrap gap-2">

              <button
                type="button"
                onClick={() =>
                  setShowEvidenceForm(
                    (current) =>
                      !current,
                  )
                }
                className="rounded-xl border border-cyan-300/15 bg-cyan-300/[0.05] px-4 py-2.5 text-[7px] font-bold uppercase tracking-[0.13em] text-cyan-200"
              >
                + Add Evidence
              </button>


              <button
                type="button"
                onClick={() =>
                  setShowVerificationForm(
                    (current) =>
                      !current,
                  )
                }
                className="rounded-xl border border-emerald-300/15 bg-emerald-300/[0.05] px-4 py-2.5 text-[7px] font-bold uppercase tracking-[0.13em] text-emerald-200"
              >
                + Add Verification
              </button>

            </div>

          </div>


          {/* ==================================================
             EVIDENCE FORM
          ================================================== */}

          {showEvidenceForm && (
            <div className="mt-5 rounded-xl border border-cyan-300/10 bg-black/[0.15] p-5">

              <div className="text-[8px] font-bold uppercase tracking-[0.16em] text-cyan-200/60">
                Add Evidence Record
              </div>


              <div className="mt-5 grid gap-4 md:grid-cols-2">

                <MachineryTrace13Input
                  label="Evidence Title"
                  value={
                    evidenceTitle
                  }
                  onChange={
                    setEvidenceTitle
                  }
                  required
                />


                <MachineryTrace13Select
                  label="Evidence Type"
                  value={
                    evidenceType
                  }
                  options={[
                    "document",
                    "photo",
                    "video",
                    "certificate",
                    "test_report",
                    "other",
                  ]}
                  onChange={(
                    value,
                  ) =>
                    setEvidenceType(
                      value as MachineryTrace13EvidenceType,
                    )
                  }
                />


                <MachineryTrace13Input
                  label="Evidence Reference"
                  value={
                    evidenceReference
                  }
                  onChange={
                    setEvidenceReference
                  }
                  placeholder="File name / document no. / reference"
                />


                <MachineryTrace13Select
                  label="Evidence Status"
                  value={
                    evidenceStatus
                  }
                  options={[
                    "pending",
                    "submitted",
                    "verified",
                    "rejected",
                    "not_applicable",
                  ]}
                  onChange={(
                    value,
                  ) =>
                    setEvidenceStatus(
                      value as MachineryTrace13Status,
                    )
                  }
                />


                <MachineryTrace13Input
                  label="Uploaded By"
                  value={
                    evidenceUploadedBy
                  }
                  onChange={
                    setEvidenceUploadedBy
                  }
                />


                <MachineryTrace13Input
                  label="Upload Date"
                  type="date"
                  value={
                    evidenceUploadedAt
                  }
                  onChange={
                    setEvidenceUploadedAt
                  }
                />


                <MachineryTrace13Input
                  label="Verified By"
                  value={
                    evidenceVerifiedBy
                  }
                  onChange={
                    setEvidenceVerifiedBy
                  }
                />


                <MachineryTrace13Input
                  label="Verification Date"
                  type="date"
                  value={
                    evidenceVerifiedAt
