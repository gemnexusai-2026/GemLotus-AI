/* ============================================================
   VALIDATION ENGINE
============================================================ */

function MachineryGate12Validate({
  records,
  assessorName,
  assessorDesignation,
  assessmentDate,
  conclusion,
  evidenceCount,
  acceptedEvidence,
  pendingEvidence,
  rejectedEvidence,
  openFindings,
  majorFindings,
  criticalFindings,
  openCorrectiveActions,
  completedCorrectiveActions,
}: {
  records: MachineryRecord[];
  assessorName: string;
  assessorDesignation: string;
  assessmentDate: string;
  conclusion: string;
  evidenceCount: number;
  acceptedEvidence: number;
  pendingEvidence: number;
  rejectedEvidence: number;
  openFindings: number;
  majorFindings: number;
  criticalFindings: number;
  openCorrectiveActions: number;
  completedCorrectiveActions: number;
}): MachineryGate12Result {
  const blockers: MachineryGate12Issue[] =
    [];

  const warnings: MachineryGate12Issue[] =
    [];

  const information: MachineryGate12Issue[] =
    [];


  let checkCount =
    0;

  let passedCount =
    0;


  function check(
    condition: boolean,
    issue: MachineryGate12Issue,
  ) {
    checkCount +=
      1;

    if (
      condition
    ) {
      passedCount +=
        1;

      return;
    }

    if (
      issue.severity ===
      "blocker" ||
      issue.severity ===
      "critical"
    ) {
      blockers.push(
        issue,
      );

      return;
    }

    if (
      issue.severity ===
      "warning"
    ) {
      warnings.push(
        issue,
      );

      return;
    }

    information.push(
      issue,
    );
  }


  /* ==========================================================
     MACHINERY REGISTER
  ========================================================== */

  check(
    records.length >
      0,
    {
      id:
        "gate12-machinery-exists",

      category:
        "machinery",

      severity:
        "blocker",

      title:
        "Machinery register is empty",

      description:
        "At least one machinery record is required.",

      resolution:
        "Add the machinery physically available at the assessed facility.",
    },
  );


  check(
    records.every(
      (record) =>
        MachineryGate12HasMachineIdentity(
          record,
        ),
    ),
    {
      id:
        "gate12-machinery-identity",

      category:
        "machinery",

      severity:
        "blocker",

      title:
        "Machinery identity is incomplete",

      description:
        "One or more machinery records do not contain a usable machine identity.",

      resolution:
        "Complete machine name or equivalent identification details.",
    },
  );


  check(
    records.every(
      (record) =>
        MachineryGate12HasPositiveQuantity(
          record,
        ),
    ),
    {
      id:
        "gate12-machinery-quantity",

      category:
        "machinery",

      severity:
        "blocker",

      title:
        "Machinery quantity is incomplete",

      description:
        "One or more machinery records do not contain a valid quantity.",

      resolution:
        "Enter the physically available quantity for each machinery record.",
    },
  );


  /* ==========================================================
     PHYSICAL VERIFICATION
  ========================================================== */

  const physicalVerified =
    records.filter(
      (record) =>
        "physicalVerification" in
          record &&
        record.physicalVerification ===
          true,
    ).length;


  check(
    records.length >
      0 &&
      physicalVerified ===
        records.length,
    {
      id:
        "gate12-physical-verification",

      category:
        "verification",

      severity:
        "blocker",

      title:
        "Physical verification incomplete",

      description:
        `${records.length - physicalVerified} machinery record(s) are not physically verified.`,

      resolution:
        "Complete physical verification for every declared machinery record.",
    },
  );


  /* ==========================================================
     OPERATIONAL VERIFICATION
  ========================================================== */

  const operationalVerified =
    records.filter(
      (record) =>
        "operationalDuringVisit" in
          record &&
        record.operationalDuringVisit ===
          true,
    ).length;


  check(
    records.length >
      0 &&
      operationalVerified ===
        records.length,
    {
      id:
        "gate12-operational-verification",

      category:
        "verification",

      severity:
        "warning",

      title:
        "Operational verification incomplete",

      description:
        `${records.length - operationalVerified} machinery record(s) do not have operational verification recorded.`,

      resolution:
        "Record operational status observed during assessment.",
    },
  );


  /* ==========================================================
     EVIDENCE
  ========================================================== */

  check(
    evidenceCount >
      0,
    {
      id:
        "gate12-evidence-exists",

      category:
        "evidence",

      severity:
        "blocker",

      title:
        "No evidence records",

      description:
        "No supporting evidence has been registered for the machinery assessment.",

      resolution:
        "Register and attach applicable machinery evidence.",
    },
  );


  check(
    rejectedEvidence ===
      0,
    {
      id:
        "gate12-evidence-rejected",

      category:
        "evidence",

      severity:
        "blocker",

      title:
        "Rejected evidence remains",

      description:
        `${rejectedEvidence} evidence record(s) are marked rejected.`,

      resolution:
        "Replace, correct or re-verify rejected evidence.",
    },
  );


  check(
    acceptedEvidence ===
      evidenceCount &&
      evidenceCount >
        0,
    {
      id:
        "gate12-evidence-accepted",

      category:
        "evidence",

      severity:
        "warning",

      title:
        "Evidence verification incomplete",

      description:
        `${Math.max(
          0,
          evidenceCount -
            acceptedEvidence,
        )} evidence record(s) are not accepted.`,

      resolution:
        "Complete evidence verification before final acceptance.",
    },
  );


  check(
    pendingEvidence ===
      0,
    {
      id:
        "gate12-evidence-pending",

      category:
        "evidence",

      severity:
        "warning",

      title:
        "Pending evidence remains",

      description:
        `${pendingEvidence} evidence record(s) remain pending.`,

      resolution:
        "Complete verification or document the reason for pending status.",
    },
  );


  /* ==========================================================
     FINDINGS
  ========================================================== */

  check(
    criticalFindings ===
      0,
    {
      id:
        "gate12-critical-findings",

      category:
        "findings",

      severity:
        "critical",

      title:
        "Critical findings remain open",

      description:
        `${criticalFindings} critical finding(s) remain unresolved.`,

      resolution:
        "Resolve and verify all critical findings before submission.",
    },
  );


  check(
    majorFindings ===
      0,
    {
      id:
        "gate12-major-findings",

      category:
        "findings",

      severity:
        "warning",

      title:
        "Major findings remain",

      description:
        `${majorFindings} major finding(s) remain unresolved.`,

      resolution:
        "Close major findings or document an approved conditional disposition.",
    },
  );


  check(
    openFindings ===
      0,
    {
      id:
        "gate12-open-findings",

      category:
        "findings",

      severity:
        "warning",

      title:
        "Open findings remain",

      description:
        `${openFindings} finding(s) remain open.`,

      resolution:
        "Resolve findings or document an approved corrective-action plan.",
    },
  );


  /* ==========================================================
     CORRECTIVE ACTIONS
  ========================================================== */

  check(
    openCorrectiveActions ===
      0,
    {
      id:
        "gate12-open-actions",

      category:
        "corrective_action",

      severity:
        "warning",

      title:
        "Corrective actions remain open",

      description:
        `${openCorrectiveActions} corrective action(s) remain open.`,

      resolution:
        "Complete and verify corrective actions before final acceptance.",
    },
  );


  check(
    completedCorrectiveActions >=
      0,
    {
      id:
        "gate12-action-count",

      category:
        "corrective_action",

      severity:
        "info",

      title:
        "Corrective action register checked",

      description:
        "Corrective action count has been evaluated.",

      resolution:
        "No action required.",
    },
  );


  /* ==========================================================
     ASSESSOR
  ========================================================== */

  check(
    assessorName.trim()
      .length >
      0,
    {
      id:
        "gate12-assessor-name",

      category:
        "assessor",

      severity:
        "blocker",

      title:
        "Assessor name missing",

      description:
        "The assessment does not identify the assessor.",

      resolution:
        "Enter the assessor's name.",
    },
  );


  check(
    assessorDesignation.trim()
      .length >
      0,
    {
      id:
        "gate12-assessor-designation",

      category:
        "assessor",

      severity:
        "blocker",

      title:
        "Assessor designation missing",

      description:
        "The assessor designation has not been recorded.",

      resolution:
        "Enter the assessor's designation.",
    },
  );


  check(
    assessmentDate.trim()
      .length >
      0,
    {
      id:
        "gate12-assessment-date",

      category:
        "assessor",

      severity:
        "blocker",

      title:
        "Assessment date missing",

      description:
        "The assessment date has not been recorded.",

      resolution:
        "Enter the assessment date.",
    },
  );


  /* ==========================================================
     CONCLUSION
  ========================================================== */

  check(
    conclusion.trim()
      .length >=
      20,
    {
      id:
        "gate12-conclusion",

      category:
        "conclusion",

      severity:
        "blocker",

      title:
        "Final conclusion is incomplete",

      description:
        "A meaningful assessor conclusion is required.",

      resolution:
        "Enter a final conclusion of at least 20 characters.",
    },
  );


  /* ==========================================================
     INFORMATION
  ========================================================== */

  information.push({
    id:
      "gate12-information-review",

    category:
      "assessment",

    severity:
      "info",

    title:
      "Final assessor review required",

    description:
      "Validation confirms data completeness but does not replace professional assessor judgement.",

    resolution:
      "Review the complete assessment before final submission.",
  });


  information.push({
    id:
      "gate12-information-evidence",

    category:
      "assessment",

    severity:
      "info",

    title:
      "Evidence must remain traceable",

    description:
      "Final submission should retain traceability between machinery, evidence and verification records.",

    resolution:
      "Confirm evidence linkage and audit trail before submission.",
  });


  /* ==========================================================
     DECISION
  ========================================================== */

  let decision:
    MachineryGate12Decision =
    "pass";


  if (
    blockers.length >
    0
  ) {
    decision =
      "blocked";
  } else if (
    warnings.length >
    0
  ) {
    decision =
      "conditional";
  }


  const completionPercent =
    checkCount ===
    0
      ? 0
      : Math.round(
          (passedCount /
            checkCount) *
            100,
        );


  return {
    decision,
    completionPercent,
    blockers,
    warnings,
    information,
    totalChecks:
      checkCount,
    passedChecks:
      passedCount,
  };
}


/* ============================================================
   MACHINE IDENTITY CHECK
============================================================ */

function MachineryGate12HasMachineIdentity(
  record: MachineryRecord,
): boolean {
  if (
    "name" in
      record &&
    typeof record.name ===
      "string" &&
    record.name.trim()
      .length >
      0
  ) {
    return true;
  }


  if (
    "machineName" in
      record &&
    typeof record.machineName ===
      "string" &&
    record.machineName.trim()
      .length >
      0
  ) {
    return true;
  }


  if (
    "equipmentName" in
      record &&
    typeof record.equipmentName ===
      "string" &&
    record.equipmentName.trim()
      .length >
      0
  ) {
    return true;
  }


  return false;
}


/* ============================================================
   QUANTITY CHECK
============================================================ */

function MachineryGate12HasPositiveQuantity(
  record: MachineryRecord,
): boolean {
  if (
    "quantity" in
      record &&
    typeof record.quantity ===
      "number"
  ) {
    return (
      record.quantity >
      0
    );
  }


  if (
    "quantity" in
      record &&
    typeof record.quantity ===
      "string"
  ) {
    return (
      Number(
        record.quantity,
      ) >
      0
    );
  }


  return true;
}


/* ============================================================
   DECISION CARD
============================================================ */

function MachineryGate12DecisionCard({
  result,
}: {
  result: MachineryGate12Result;
}) {
  let borderClass =
    "border-emerald-300/10 bg-emerald-300/[0.025]";

  let valueClass =
    "text-emerald-200";


  if (
    result.decision ===
    "conditional"
  ) {
    borderClass =
      "border-amber-300/10 bg-amber-300/[0.025]";

    valueClass =
      "text-amber-200";
  }


  if (
    result.decision ===
    "blocked"
  ) {
    borderClass =
      "border-red-300/10 bg-red-300/[0.025]";

    valueClass =
      "text-red-200";
  }


  return (
    <div
      className={`rounded-2xl border p-6 ${borderClass}`}
    >

      <div className="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">

        <div>

          <div className="text-[8px] font-bold uppercase tracking-[0.18em] text-white/25">
            Gate Decision
          </div>

          <div
            className={`mt-2 text-3xl font-semibold ${valueClass}`}
          >
            {MachineryGate12Label(
              result.decision,
            )}
          </div>

        </div>


        <div className="text-right">

          <div className="text-[7px] uppercase tracking-[0.14em] text-white/20">
            Validation
          </div>

          <div className="mt-1 text-2xl font-semibold text-white/60">
            {result.completionPercent}%
          </div>

        </div>

      </div>


      <p className="mt-5 max-w-3xl text-[9px] leading-6 text-white/30">
        {result.decision ===
        "blocked"
          ? "One or more mandatory validation conditions remain unresolved. Final submission must not proceed until blockers are addressed."
          : result.decision ===
            "conditional"
          ? "No hard blocker remains, but warnings require documented review or conditional disposition."
          : "All current mandatory validation checks have passed."}
      </p>

    </div>
  );
}


