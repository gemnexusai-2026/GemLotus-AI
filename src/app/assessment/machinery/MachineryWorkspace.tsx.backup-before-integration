  function VerificationBadge({
    status,
  }: {
    status: string;
  }) {
    const normalized =
      status.toLowerCase();
  
    let className =
      "border-white/[0.08] bg-white/[0.03] text-white/35";
  
    if (
      normalized === "verified" ||
      normalized === "accepted"
    ) {
      className =
        "border-emerald-400/10 bg-emerald-400/[0.05] text-emerald-300";
    }
  
    if (
      normalized === "rejected"
    ) {
      className =
        "border-red-400/10 bg-red-400/[0.05] text-red-300";
    }
  
    if (
      normalized === "needs_review"
    ) {
      className =
        "border-amber-400/10 bg-amber-400/[0.05] text-amber-300";
    }
  
    return (
      <span
        className={`inline-flex rounded-lg border px-2.5 py-1.5 text-[7px] font-bold uppercase tracking-[0.12em] ${className}`}
      >
        {formatLabel(
          status || "pending",
        )}
      </span>
    );
  }

